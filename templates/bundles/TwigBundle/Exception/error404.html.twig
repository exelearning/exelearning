{% extends 'base.html.twig' %}

{% block title %}404 — Page Not Found{% endblock %}

{% block body %}
<div class="error-page">
    <div class="error-content">
        <h1>404 — Page Not Found</h1>
        <p>The resource you are trying to preview is not available. It may have been deleted or moved.</p>
        <a href="/" class="btn btn-primary">Back to Home</a>
        <div class="error-meta">If you believe this is an error, please check that the URL is correct or contact the administrator.</div>
    </div>
</div>

<style>
.error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: #f8fafc;
}
.error-content {
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(2,6,23,.08);
    max-width: 720px;
    width: 100%;
    padding: 2.25rem;
    text-align: center;
}
h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
    color: #111;
}
p {
    margin: 0 0 1.5rem;
    color: #6b7280;
}
.btn-primary {
    display: inline-block;
    padding: 0.625rem 0.875rem;
    border-radius: 0.5rem;
    background: #1f7bd8;
    color: #fff;
    text-decoration: none;
    transition: background-color 0.2s;
}
.btn-primary:hover {
    background: #1a69b9;
}
.error-meta {
    margin-top: 1rem;
    color: #6b7280;
    font-size: 0.8125rem;
}
</style>
{% endblock %}