<div class="modal exe-modal-fade" tabindex="-1" id="modalDownloadPage" role="dialog" aria-hidden="true" data-open="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title modal-title-icons"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Close' | trans }}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p class="download-page-title fw-bold mb-2"></p>
                <div class="form-group">
                    <label for="download-page-format" class="form-label">{{ 'Download as...' | trans }}</label>
                    <select id="download-page-format" class="form-control"></select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="close cancel btn btn-secondary" data-dismiss="modal">{{ 'Cancel' | trans }}</button>
                <button type="button" class="btn btn-primary confirm">{{ 'Download' | trans }}</button>
            </div>
        </div>
    </div>
</div>
