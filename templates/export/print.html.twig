{% extends 'base.html.twig' %}
{% import _self as printMacros %}

{% macro page_heading(page) %}
    {% set headingLevel = page.level + 2 %}
    {% if headingLevel > 6 %}
        {% set headingLevel = 6 %}
    {% endif %}
    {% set tag = 'h' ~ headingLevel %}
    <{{ tag }} class="page-title">{{ page.title }}</{{ tag }}>
{% endmacro %}

{% block title %}{{ document.title }} · {{ 'Print view'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('style/print.css') }}">
{% endblock %}

{% block class %}print-view{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var printButton = document.querySelector('[data-action="trigger-print"]');
            if (printButton) {
                printButton.addEventListener('click', function () {
                    window.print();
                });
            }
        });
    </script>
{% endblock %}

{% block body %}
    <div class="print-layout" id="print-layout">
        <header class="print-header">
            <div class="print-controls" aria-hidden="true">
                <button type="button" class="print-button" data-action="trigger-print">
                    {{ 'Print'|trans }}
                </button>
            </div>
            <h1 class="document-title">{{ document.title }}</h1>
            <dl class="print-meta">
                <div>
                    <dt>{{ 'Author'|trans }}</dt>
                    <dd>{{ document.author is not empty ? document.author : '—' }}</dd>
                </div>
                <div>
                    <dt>{{ 'Generated on'|trans }}</dt>
                    <dd>
                        {{ document.generatedAt|date('Y-m-d H:i') }}
                    </dd>
                </div>
            </dl>
            {% if document.description %}
                <p class="print-description">{{ document.description }}</p>
            {% endif %}
            {% set pages = document.pages %}
            {% if pages|length > 1 %}
                <nav class="print-toc" aria-label="{{ 'Table of contents'|trans }}">
                    <h2>{{ 'Table of contents'|trans }}</h2>
                    <ol class="toc-list">
                        {% for page in pages %}
                            <li class="toc-item level-{{ page.level }}">
                                <a href="#{{ page.anchor }}">{{ page.title }}</a>
                            </li>
                        {% endfor %}
                    </ol>
                </nav>
            {% endif %}
        </header>
        <main class="print-content" id="print-content">
            {% for page in pages %}
                <section id="{{ page.anchor }}" class="print-page" data-level="{{ page.level }}">
                    <header class="page-header">
                        {{ printMacros.page_heading(page) }}
                    </header>
                    <div class="page-body">
                        {{ page.content|raw }}
                    </div>
                </section>
            {% endfor %}
        </main>
    </div>
{% endblock %}
