{
    // Type-checks test files, which tsconfig.json excludes. `make typecheck` runs it
    // after the main project. Coverage grows directory by directory: add a directory
    // to "include" once its specs are clean.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["bun", "bun-types/test-globals"],
        // scripts/ specs import .mts modules directly; nothing is emitted.
        "allowImportingTsExtensions": true
    },
    "include": [
        // Ambient declarations the main project picks up implicitly.
        "src/**/*.d.ts",
        "app/**/*.spec.ts",
        "scripts/**/*.spec.ts",
        "src/cli/**/*.spec.ts",
        "src/utils/**/*.spec.ts",
        "src/websocket/**/*.spec.ts",
        "src/yjs/**/*.spec.ts",
        "test/helpers/**/*.ts"
    ],
    "exclude": ["node_modules", "dist", "app/dist"]
}
