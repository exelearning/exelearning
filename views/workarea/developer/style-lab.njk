    // ─── Quick CSS builder (eXeLearning selectors) ────────────
    function collectQuick() {
        const q = {};
        document.querySelectorAll('[data-quick]').forEach(el => {
            const k = el.dataset.quick;
            if (el.type === 'checkbox') q[k] = el.checked;
            else if (el.type === 'number') q[k] = parseFloat(el.value) || 0;
            else q[k] = el.value;
        });
        return q;
    }

    function buildQuickCss(q) {
        const bang = ' !important';
        let css = '';
        // Content width
        const mode = String(q.contentWidthMode || 'default').toLowerCase();
        if (mode !== 'default') {
            const mw = mode === 'percent'
                ? `${q.contentWidthPercent || 100}%`
                : mode === 'mixed'
                    ? `min(${q.contentWidth || 1280}px, ${q.contentWidthPercent || 100}%)`
                    : `${q.contentWidth || 1280}px`;
            const center = q.contentCentered !== false;
            css += `#node-content-container, .exe-content { max-width: ${mw}${bang}; margin-left: ${center ? 'auto' : '0'}${bang}; margin-right: ${center ? 'auto' : '0'}${bang}; }\n`;
        }
        // Colors
        if (q.linkColor) css += `.exe-content a { color: ${q.linkColor}${bang}; }\n`;
        if (q.titleColor) css += `.exe-content .page-title { color: ${q.titleColor}${bang}; }\n`;
        if (q.textColor) css += `.exe-content { color: ${q.textColor}${bang}; }\n`;
        if (q.contentBgColor) css += `.exe-content, .page-content { background-color: ${q.contentBgColor}${bang}; }\n`;
        if (q.pageBgColor) css += `body { background-color: ${q.pageBgColor}${bang}; }\n`;
        if (q.contentOuterBgColor) css += `body.exe-export { background-color: ${q.contentOuterBgColor}${bang}; }\n`;
        // Typography
        if (q.fontBody) css += `body, .exe-content { font-family: ${q.fontBody}${bang}; }\n`;
        if (q.fontTitles) css += `.exe-content .page-title, .exe-content .box-title, .exe-content .iDeviceTitle, .exe-content h1, .exe-content h2, .exe-content h3 { font-family: ${q.fontTitles}${bang}; }\n`;
        if (q.baseFontSize) css += `body { font-size: ${q.baseFontSize}px${bang}; }\n`;
        if (q.lineHeight) css += `body { line-height: ${q.lineHeight}${bang}; }\n`;
        // Page title
        if (q.pageTitleSize) css += `.exe-content .page-title { font-size: ${q.pageTitleSize}rem${bang}; }\n`;
        if (q.pageTitleWeight) css += `.exe-content .page-title { font-weight: ${q.pageTitleWeight}${bang}; }\n`;
        if (q.pageTitleUppercase) css += `.exe-content .page-title { text-transform: uppercase${bang}; }\n`;
        if (q.pageTitleLetterSpacing) css += `.exe-content .page-title { letter-spacing: ${q.pageTitleLetterSpacing}px${bang}; }\n`;
        if (q.pageTitleMarginBottom) css += `.exe-content .page-title { margin-bottom: ${q.pageTitleMarginBottom}rem${bang}; }\n`;
        // Project (package) title
        if (q.packageTitleColor) css += `.exe-content .package-title { color: ${q.packageTitleColor}${bang}; }\n`;
        if (q.packageTitleSize) css += `.exe-content .package-title { font-size: ${q.packageTitleSize}rem${bang}; }\n`;
        if (q.packageTitleWeight) css += `.exe-content .package-title { font-weight: ${q.packageTitleWeight}${bang}; }\n`;
        // Navigation menu
        if (q.fontMenu) css += `#siteNav a, .site-nav a { font-family: ${q.fontMenu}${bang}; }\n`;
        if (q.menuBgColor) css += `#siteNav, .site-nav { background-color: ${q.menuBgColor}${bang}; }\n`;
        if (q.menuTextColor) css += `#siteNav a, .site-nav a { color: ${q.menuTextColor}${bang}; }\n`;
