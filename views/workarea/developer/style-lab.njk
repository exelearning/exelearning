    let serverThemeFileList = {};
    const ASSET_REMOVE_BTNS = {
        'img/custom-logo.':       'btn-remove-logo',
        'img/favicon.':           'btn-remove-favicon',
        'img/custom-background.': 'btn-remove-bg-image',
        'img/custom-header.':     'btn-remove-header-image',
        'img/custom-footer.':     'btn-remove-footer-image',
        'img/custom-nav-prev.':   'btn-remove-nav-prev',
        'img/custom-nav-next.':   'btn-remove-nav-next',
        'img/custom-nav-toggle.': 'btn-remove-nav-toggle',
    };
    let inspectMode = false;
    let clickEditSelector = '';
    let applyDebounce = 0;
    let quickState = {};        // collected from [data-quick] inputs
    let assetStateTouched = false;
    let themeReloadToken = Date.now();

    // ─── Undo / Redo stacks ───────────────────────────────────
    const UNDO_MAX = 30;
    let undoStack = [];
    let redoStack = [];

    function updateUndoRedoBtns() {
        document.getElementById('btn-undo').disabled = undoStack.length === 0;
        document.getElementById('btn-redo').disabled = redoStack.length === 0;
    }

    function currentSnap() {
        return { css: document.getElementById('sl-css-textarea').value, qs: JSON.stringify(quickState) };
    }

    function applySnap(snap) {
        const ta = document.getElementById('sl-css-textarea');
        ta.value = snap.css;
        markModified(ta.value !== originalCss);
        updateHighlight();
        if (previewReady) injectEditorCss(snap.css);
        quickState = JSON.parse(snap.qs);
        document.querySelectorAll('[data-quick]').forEach(el => {
            const v = quickState[el.dataset.quick];
            if (v === undefined) return;
            if (el.type === 'checkbox') {
                el.checked = !!v;
                el.closest('.sl-apply-chip')?.classList.toggle('checked', !!v);
            } else {
                el.value = v;
            }
        });
        if (typeof updateContentWidthVisibility === 'function')
            updateContentWidthVisibility(quickState.contentWidthMode || 'default');
        if (previewReady) injectQuickCss(buildScopeWrapped(buildQuickCss(quickState)));
    }

    function pushUndo() {
        const snap = currentSnap();
        const last = undoStack[undoStack.length - 1];
        if (last && last.css === snap.css && last.qs === snap.qs) return;
        undoStack.push(snap);
        if (undoStack.length > UNDO_MAX) undoStack.shift();
        redoStack = []; // new action clears redo
        updateUndoRedoBtns();
    }

    function doUndo() {
        if (!undoStack.length) return;
        redoStack.push(currentSnap());
        applySnap(undoStack.pop());
        updateUndoRedoBtns();
        setStatus(T.undone);
    }

    function doRedo() {
        if (!redoStack.length) return;
        undoStack.push(currentSnap());
        applySnap(redoStack.pop());
        updateUndoRedoBtns();
        setStatus(T.redone);
    }

    document.getElementById('btn-undo').addEventListener('click', doUndo);
    document.getElementById('btn-redo').addEventListener('click', doRedo);

    // ─── CSS Scope ────────────────────────────────────────────
    const SCOPE_ALL = ['exe-web-site', 'exe-single-page', 'exe-scorm'];

    function getScopeClasses() {
        return [...document.querySelectorAll('#sl-preview-toolbar .sl-scope-chip input:checked')].map(i => i.value);
    }

    function buildScopeWrapped(innerCss) {
        const classes = getScopeClasses();
        const trimmed = innerCss.trim();
        if (!trimmed) return '';
        if (classes.length === 0 || classes.length === SCOPE_ALL.length) return trimmed;
        const prefixes = classes.map(c => `body.${c}`);

        // Expand each top-level rule's selector instead of using CSS nesting,
        // so the output works in all browsers and scopes are enforced correctly.
        const out = [];
        let rest = trimmed;
        while (rest.length) {
            rest = rest.trimStart();
            if (!rest) break;
            // pass CSS comments through unchanged
            if (rest.startsWith('/*')) {
                const end = rest.indexOf('*/', 2);
                if (end === -1) { out.push(rest); break; }
                out.push(rest.slice(0, end + 2));
                rest = rest.slice(end + 2);
                continue;
            }
            const braceIdx = rest.indexOf('{');
            if (braceIdx === -1) { out.push(rest.trim()); break; }
            const ruleSelector = rest.slice(0, braceIdx).trim();
            rest = rest.slice(braceIdx + 1);
            // find the matching closing brace
            let depth = 1, idx = 0;
            while (idx < rest.length && depth > 0) {
                if (rest[idx] === '{') depth++;
                else if (rest[idx] === '}') depth--;
                idx++;
            }
            const block = rest.slice(0, idx - 1).trim();
            rest = rest.slice(idx);
            if (ruleSelector.startsWith('@')) {
                // @-rules (e.g. @media) are passed through without scope prefix
                out.push(`${ruleSelector} {\n${block}\n}`);
            } else {
                const parts = ruleSelector.split(',').map(s => s.trim()).filter(Boolean);
                const expanded = prefixes.flatMap(p => parts.map(s => `${p} ${s}`));
                const indented = block.split('\n').map(l => l ? `  ${l}` : l).join('\n');
                out.push(`${expanded.join(',\n')} {\n${indented}\n}`);
            }
        }
        return out.join('\n\n');
    }

    // Maps each export-type button value to its corresponding body scope class
    const EXPORT_SCOPE_MAP = {
        'html5':    'exe-web-site',
        'html5-sp': 'exe-single-page',
        'scorm12':  'exe-scorm',
    };

    const SCOPE_LABELS = {
        'exe-web-site':    'Website',
        'exe-single-page': 'Single',
        'exe-scorm':       'SCORM',
    };

    function isCurrentViewInScope() {
        const classes = getScopeClasses();
        // All or none selected → CSS is unwrapped (applies to every export type)
        if (classes.length === 0 || classes.length === SCOPE_ALL.length) return true;
        const viewScope = EXPORT_SCOPE_MAP[selectedExport];
        return viewScope ? classes.includes(viewScope) : true;
    }

    function updateEditingAllowed() {
        const allowed = isCurrentViewInScope();

        // Inspect button — disable and turn off if active
        const btnInspect = document.getElementById('btn-inspect');
        btnInspect.disabled = !allowed;
        if (!allowed && inspectMode) setInspect(false);

        // CSS editor and its action buttons
        document.getElementById('sl-css-textarea').readOnly = !allowed;
        document.getElementById('btn-apply-css').disabled = !allowed;
        document.getElementById('btn-wrap-scope').disabled = !allowed;

        // Quick settings inputs
        document.querySelectorAll('[data-quick]').forEach(el => { el.disabled = !allowed; });

        // Notice banner
        const notice = document.getElementById('sl-scope-notice');
        if (!allowed) {
            const viewScope = EXPORT_SCOPE_MAP[selectedExport];
            const label = SCOPE_LABELS[viewScope] || selectedExport;
            notice.textContent = `⚠ Editing disabled: enable "${label}" in Scope to make changes in this preview.`;
            notice.hidden = false;
        } else {
            notice.hidden = true;
        }
    }

    function enforceScopeNotEmpty() {
        const chips = [...document.querySelectorAll('#sl-preview-toolbar .sl-scope-chip')];
        const anyChecked = chips.some(ch => ch.querySelector('input').checked);
        if (!anyChecked) {
            chips.forEach(ch => {
                ch.querySelector('input').checked = true;
                ch.classList.add('checked');
            });
        }
    }

    document.querySelectorAll('#sl-preview-toolbar .sl-scope-chip').forEach(chip => {
        chip.addEventListener('click', () => {
            const cb = chip.querySelector('input');
            cb.checked = !cb.checked;
            chip.classList.toggle('checked', cb.checked);
            enforceScopeNotEmpty();
            updateEditingAllowed();
            if (previewReady) {
                if (Object.keys(quickState).length) {
                    injectQuickCss(buildScopeWrapped(buildQuickCss(quickState)));
                }
                injectEditorCss(document.getElementById('sl-css-textarea').value);
            }
        });
    });

    // Apply-in chips: visual sync + quickState update
    document.querySelectorAll('#sl-apply-in-section .sl-apply-chip').forEach(chip => {
        chip.addEventListener('click', () => {
            const cb = chip.querySelector('input[data-quick]');
            cb.checked = !cb.checked;
            chip.classList.toggle('checked', cb.checked);
            // Dispatch input so the [data-quick] handler picks it up
            cb.dispatchEvent(new Event('input', { bubbles: true }));
        });
    });

    // ─── Controlled blocks ────────────────────────────────────
    function replaceControlledBlock(css, start, end, content) {
        const trimmed = String(content || '').trim();
        const block = trimmed ? `${start}\n${trimmed}\n${end}` : '';
        const escapeRe = value => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const re = new RegExp(`${escapeRe(start)}[\\s\\S]*?${escapeRe(end)}`);
        if (re.test(css)) {
            return css.replace(re, block).replace(/\n{3,}/g, '\n\n').trimEnd();
        }
        return block ? `${css.trimEnd()}\n\n${block}` : css;
    }

    function appendToControlledBlock(css, start, end, content) {
        const escapeRe = value => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const re = new RegExp(`${escapeRe(start)}\\n?([\\s\\S]*?)\\n?${escapeRe(end)}`);
        const existing = re.exec(css)?.[1]?.trim();
        const next = [existing, String(content || '').trim()].filter(Boolean).join('\n\n');
        return replaceControlledBlock(css, start, end, next);
    }

    // ─── Highlight.js for CSS editor ─────────────────────────
    function updateHighlight() {
        const code = document.querySelector('#sl-css-highlight code');
        const ta = document.getElementById('sl-css-textarea');
        code.textContent = ta.value;
        if (window.hljs) hljs.highlightElement(code);
        syncScroll();
    }

    function syncScroll() {
        const ta = document.getElementById('sl-css-textarea');
        const pre = document.getElementById('sl-css-highlight');
        pre.scrollTop = ta.scrollTop;
        pre.scrollLeft = ta.scrollLeft;
    }

    document.getElementById('sl-css-textarea').addEventListener('focus', pushUndo);
    document.getElementById('sl-css-textarea').addEventListener('input', () => {
        markModified(true);
        updateHighlight();
        clearTimeout(applyDebounce);
        applyDebounce = setTimeout(() => {
            if (previewReady) injectEditorCss(document.getElementById('sl-css-textarea').value);
        }, 600);
    });

    document.getElementById('sl-css-textarea').addEventListener('scroll', syncScroll);

    // ─── URL state ────────────────────────────────────────────
    function getParams() { return new URLSearchParams(location.search); }
    function pushParams(patch) {
        const p = getParams();
        for (const [k, v] of Object.entries(patch)) {
            if (v == null) p.delete(k); else p.set(k, String(v));
        }
        history.replaceState(null, '', '?' + p.toString());
    }

    function pushQuickParams() {
        const p = getParams();
        for (const key of [...p.keys()]) if (key.startsWith('q_')) p.delete(key);
        for (const [k, v] of Object.entries(quickState)) p.set('q_' + k, String(v));
        history.replaceState(null, '', '?' + p.toString());
    }

    // ─── Service Worker ───────────────────────────────────────
    async function ensureServiceWorker() {
        if (!navigator.serviceWorker) throw new Error('Service Workers not supported');
        if (swRegistration) return swRegistration;
        const scope = basePath + '/viewer/';
        const swPath = basePath + '/preview-sw.js';
        const existing = await navigator.serviceWorker.getRegistration(scope);
        if (existing?.active) { swRegistration = existing; return swRegistration; }
        swRegistration = await navigator.serviceWorker.register(swPath, { scope });
        await new Promise(resolve => {
            if (swRegistration.active) { resolve(); return; }
            const w = swRegistration.installing || swRegistration.waiting;
            if (w) w.addEventListener('statechange', () => { if (w.state === 'activated') resolve(); });
            else resolve();
        });
        return swRegistration;
    }

    async function sendToSW(files) {
        const sw = swRegistration?.active || navigator.serviceWorker?.controller;
        if (!sw) throw new Error('No active Service Worker');
        // Step 1: SET_CONTENT + wait for CONTENT_READY
        const fileCount = await new Promise((resolve, reject) => {
            const ch = new MessageChannel();
            const t = setTimeout(() => reject(new Error('SW timeout')), 15000);
            ch.port1.onmessage = e => {
                clearTimeout(t);
                if (e.data?.type === 'CONTENT_READY') resolve(e.data.fileCount);
                else reject(new Error(JSON.stringify(e.data)));
            };
            const trans = [ch.port2];
            for (const v of Object.values(files)) if (v instanceof ArrayBuffer) trans.push(v);
            sw.postMessage({ type: 'SET_CONTENT', data: { files, options: { openExternalLinksInNewWindow: true } } }, trans);
        });
        // Step 2: VERIFY_READY — needed for Firefox's stricter SW event timing
        await new Promise((resolve, reject) => {
            const ch = new MessageChannel();
            const t = setTimeout(() => reject(new Error('SW verify timeout')), 5000);
            ch.port1.onmessage = e => {
                clearTimeout(t);
                if (e.data?.ready) resolve();
                else reject(new Error('SW content not ready after verification'));
            };
            sw.postMessage({ type: 'VERIFY_READY' }, [ch.port2]);
        });
        return fileCount;
    }

    // ─── Data loading ─────────────────────────────────────────
    async function loadFixtures(val) {
        const sel = document.getElementById('sl-fixture');
        const hint = document.getElementById('sl-fixture-hint');
        try {
            const [{ fixtures }, { sessions }] = await Promise.all([
                fetch(basePath + '/api/developer/fixtures').then(r => r.json()),
                fetch(basePath + '/api/developer/sessions').then(r => r.json()).catch(() => ({ sessions: [] })),
            ]);

            loadedSessions = sessions;

            // Determine which session to auto-select.
            // If a specific session was requested via URL param, prefer it;
            // if not found in the list (e.g. saved_once=0), fall back to first session.
            const requestedSessionId = val && val.startsWith('session:') ? val.slice(8) : null;
            const matchedSession = requestedSessionId
                ? sessions.find(s => s.sessionId === requestedSessionId)
                : null;

            let autoVal = val || null;
            let autoTheme = null;
            if (matchedSession) {
                autoTheme = matchedSession.theme || null;
            } else if (!autoVal && sessions.length > 0) {
                autoVal = 'session:' + sessions[0].sessionId;
                autoTheme = sessions[0].theme || null;
            }

            let html = '<option value="">— select —</option>';
            if (sessions.length > 0) {
                html += '<optgroup label="' + T.open_project + '">';
                html += sessions.map(s => {
                    const v = 'session:' + s.sessionId;
                    const name = s.fileName.replace(/\.elpx?$/, '');
                    return `<option value="${v}"${v === autoVal ? ' selected' : ''}>▶ ${name}</option>`;
                }).join('');
                html += '</optgroup>';
                hint.style.display = 'none';
            }
            if (fixtures.length > 0) {
                html += '<optgroup label="' + T.fixtures + '">';
                html += fixtures.map(f => `<option value="${f}"${f === autoVal ? ' selected' : ''}>${f}</option>`).join('');
                html += '</optgroup>';
            }
            sel.innerHTML = html;
            return { fixture: autoVal, theme: autoTheme };
        } catch { sel.innerHTML = '<option value="">' + T.error_loading + '</option>'; return { fixture: val, theme: null }; }
    }

    async function loadThemes(val) {
        const sel = document.getElementById('sl-theme');
        try {
            const { themes } = await fetch(basePath + '/api/themes/installed').then(r => r.json());
            loadedThemes = themes;
            sel.innerHTML = '<option value="">' + T.select_theme + '</option>' +
                themes.map(t => {
                    const sel2 = val ? t.dirName === val : t.isDefault;
                    return `<option value="${t.dirName}"${sel2 ? ' selected' : ''}>${t.displayName}</option>`;
                }).join('');
            // Fall back to first theme if nothing was selected
            if (!sel.value && themes.length > 0) sel.value = themes[0].dirName;
        } catch { sel.innerHTML = '<option value="">' + T.error_loading + '</option>'; }
        updateDeleteThemeBtn();
    }

    function updateDeleteThemeBtn() {
        const dirName = document.getElementById('sl-theme').value;
        const theme = loadedThemes.find(t => t.dirName === dirName);
        const btn = document.getElementById('btn-files-delete-theme');
        btn.style.display = (theme && theme.type === 'site') ? '' : 'none';
    }

    async function loadThemeFiles(themeDirName, isReload = false) {
        const theme = loadedThemes.find(t => t.dirName === themeDirName);
        if (!theme?.url) return;
        themeFiles = {};
        serverThemeFileList = {};
        const cacheToken = encodeURIComponent(String(themeReloadToken));
        const withCacheToken = url => url + (url.includes('?') ? '&' : '?') + 'slReload=' + cacheToken;
        const toFetch = [
            ...(theme.cssFiles || ['style.css']).map(f => ({ path: f, url: withCacheToken(theme.url + '/' + f) })),
            ...(theme.js     || ['style.js' ]).map(f => ({ path: f, url: withCacheToken(theme.url + '/' + f) })),
        ];
        // Fetch editable text files + server file list in parallel
        await Promise.allSettled([
            ...toFetch.map(async ({ path, url }) => {
                try {
                    const r = await fetch(url);
                    if (r.ok) themeFiles[path] = await r.text();
                } catch {}
            }),
            (async () => {
                try {
                    const r = await fetch(`${basePath}/api/developer/style-lab/theme-files?theme=${encodeURIComponent(themeDirName)}`);
                    if (r.ok) {
                        const { files } = await r.json();
                        for (const f of files) serverThemeFileList[f.path] = { size: f.size, editable: f.editable };
                    }
                } catch {}
            })(),
        ]);
        renderFileBrowser();
        const firstCss = toFetch.find(f => f.path.endsWith('.css'));
        if (firstCss && themeFiles[firstCss.path] != null) setEditorFile(firstCss.path, isReload);
    }

    function setEditorFile(path, forceReset = false) {
        const ta = document.getElementById('sl-css-textarea');
        const isAlreadyActive = path === activeCssFile;
        const isModified = document.getElementById('sl-modified-dot').classList.contains('on');

        // Auto-save current textarea content before switching files
        if (!isAlreadyActive && activeCssFile && themeFiles[activeCssFile] !== undefined) {
            themeFiles[activeCssFile] = ta.value;
        }

        const newOriginal = themeFiles[path] || '';
        activeCssFile = path;
        originalCss = newOriginal;
        document.getElementById('sl-editor-file-label').textContent = path;

        // Update syntax highlighting language and editor UI for file type
        const isJs = path.endsWith('.js');
        const code = document.querySelector('#sl-css-highlight code');
        code.className = isJs ? 'language-javascript' : 'language-css';
        document.getElementById('sl-js-hint').style.display = isJs ? '' : 'none';
        document.getElementById('btn-wrap-scope').style.display = isJs ? 'none' : '';
        document.getElementById('btn-apply-css').textContent = isJs ? T.save_js : T.apply_css;

        updateFileBrowserActiveState(path);

        // Preserve user edits when the same file reloads (e.g. export type switch)
        if (isAlreadyActive && isModified && !forceReset) return;

        ta.value = originalCss;
        markModified(false);
        updateHighlight();
    }

    function updateFileBrowserActiveState(path) {
        document.querySelectorAll('#sl-file-browser .sl-fb-item').forEach(el => {
            el.classList.toggle('sl-fb-active', el.dataset.fbPath === path);
        });
    }

    // ─── File browser ─────────────────────────────────────────
    function fbFileType(path) {
        const ext = path.split('.').pop().toLowerCase();
        if (ext === 'css') return 'css';
        if (ext === 'js')  return 'js';
        if (['png','jpg','jpeg','gif','svg','webp','ico'].includes(ext)) return 'img';
        if (['woff','woff2','ttf','otf'].includes(ext)) return 'font';
        return 'other';
    }

    function renderFileBrowser() {
        const section   = document.getElementById('sl-file-browser-section');
        const container = document.getElementById('sl-file-browser');
        const seen = new Set();
        const entries = [];
        // In-memory editable text files (CSS/JS loaded from server or ZIP)
        for (const path of Object.keys(themeFiles)) {
            if (seen.has(path)) continue; seen.add(path);
            entries.push({ path, type: fbFileType(path), source: 'memory' });
        }
        // In-memory binary assets uploaded via UI
        for (const path of Object.keys(assetBinaryFiles)) {
            if (seen.has(path)) continue; seen.add(path);
            entries.push({ path, type: fbFileType(path), source: 'memory' });
        }
        for (const path of Object.keys(fontBinaryFiles)) {
            if (seen.has(path)) continue; seen.add(path);
            entries.push({ path, type: 'font', source: 'memory' });
        }
        // Files on the server (icons, fonts, screenshot, etc.) not yet in memory
        for (const [path, info] of Object.entries(serverThemeFileList)) {
            if (seen.has(path)) continue; seen.add(path);
            entries.push({ path, type: fbFileType(path), source: 'server', editable: info.editable, size: info.size });
        }
        section.style.display = entries.length ? '' : 'none';
        if (!entries.length) { container.innerHTML = ''; return; }

        const filtered = entries.filter(e => {
            const typeOk   = fileBrowserFilter === 'all' || e.type === fileBrowserFilter;
            const searchOk = !fileBrowserSearch || e.path.toLowerCase().includes(fileBrowserSearch.toLowerCase());
            return typeOk && searchOk;
        });

        if (!filtered.length) {
            container.innerHTML = `<p style="text-align:center;color:var(--muted);font-size:12px;padding:8px 0;">${T.no_files_match}</p>`;
            return;
        }

        // Ensure blob URLs exist for images (may not if injectAssetsCss not yet called)
        for (const [p, bytes] of Object.entries(assetBinaryFiles)) {
            if (!assetBlobUrls[p]) {
                assetBlobUrls[p] = URL.createObjectURL(new Blob([bytes], { type: assetMime(p) }));
            }
        }

        container.innerHTML = filtered.map(e => {
            const ext        = e.path.split('.').pop().toLowerCase();
            const badgeCls   = `sl-fb-badge-${['css','js','img','font'].includes(e.type) ? e.type : 'other'}`;
            const thumb      = (e.type === 'img' && assetBlobUrls[e.path])
                ? `<img class="sl-fb-thumb" src="${assetBlobUrls[e.path]}" alt="">`
                : '';
            const isActive   = e.path === activeCssFile;
            const isServer   = e.source === 'server';
            const sizeLabel  = isServer && e.size != null
                ? `<span style="font-size:10px;color:var(--muted);flex-shrink:0;">${e.size < 1024 ? e.size + ' B' : Math.round(e.size / 1024) + ' KB'}</span>`
                : '';
            let actions = '';
            if ((e.type === 'css' || e.type === 'js') && (!isServer || e.editable)) {
                actions += `<button class="btn button-tertiary sl-fb-btn" data-fb-edit="${e.path}" title="Edit">✎</button>`;
            }
            if (e.type === 'img') {
                actions += `<button class="btn button-tertiary sl-fb-btn" data-fb-view="${e.path}" title="View">🔍</button>`;
                actions += `<button class="btn button-tertiary sl-fb-btn" data-fb-replace="${e.path}" data-fb-server="${isServer}" title="Replace">↑</button>`;
                if (!isServer) actions += `<button class="sl-asset-remove" data-fb-remove-asset="${e.path}" title="Remove">✕</button>`;
            }
            if (e.type === 'font' && !isServer) {
                actions += `<button class="sl-asset-remove" data-fb-remove-font="${e.path}" title="Remove">✕</button>`;
            }
            const serverThemeUrl = (() => {
                const th = loadedThemes.find(t => t.dirName === document.getElementById('sl-theme').value);
                return th?.url || '';
            })();
            const imgSrc = assetBlobUrls[e.path] || (isServer && serverThemeUrl ? serverThemeUrl + '/' + e.path : '');
            const clickableThumb = e.type === 'img'
                ? `<img class="sl-fb-thumb" src="${imgSrc}" alt="" data-fb-view="${e.path}" style="cursor:zoom-in;">`
                : '';
            return `<div class="sl-fb-item${isActive ? ' sl-fb-active' : ''}" data-fb-path="${e.path}">
                <span class="sl-fb-badge ${badgeCls}">${ext}</span>
                ${clickableThumb}
                <span class="sl-fb-path" title="${e.path}">${e.path}</span>
                ${sizeLabel}
                <div class="sl-fb-actions">${actions}</div>
            </div>`;
        }).join('');

        container.querySelectorAll('[data-fb-edit]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const p = btn.dataset.fbEdit;
                // If not yet in memory (server-only file), fetch it first
                if (themeFiles[p] === undefined) {
                    const theme = loadedThemes.find(t => t.dirName === document.getElementById('sl-theme').value);
                    if (theme?.url) {
                        try {
                            const r = await fetch(theme.url + '/' + p);
                            if (r.ok) themeFiles[p] = await r.text();
                        } catch {}
                    }
                    if (themeFiles[p] === undefined) themeFiles[p] = '';
                }
                switchTab('css');
                setEditorFile(p);
                document.getElementById('sl-editor-wrap').scrollIntoView({ behavior: 'smooth', block: 'start' });
                document.getElementById('sl-css-textarea').focus();
            });
        });

        container.querySelectorAll('[data-fb-remove-asset]').forEach(btn => {
            btn.addEventListener('click', () => { removeAsset(btn.dataset.fbRemoveAsset); });
        });

        container.querySelectorAll('[data-fb-remove-font]').forEach(btn => {
            btn.addEventListener('click', () => {
                const path = btn.dataset.fbRemoveFont;
                const fontBtn = document.querySelector(`.sl-font-remove[data-font="${CSS.escape(path)}"]`);
                if (fontBtn) { fontBtn.click(); }
                else {
                    pushUndo();
                    if (fontBlobUrls[path]) { URL.revokeObjectURL(fontBlobUrls[path]); delete fontBlobUrls[path]; }
                    delete fontBinaryFiles[path];
                    rebuildFontFacesInCss();
                    updateFontFamilyOptions();
                    renderFontList();
                    injectFontFaces();
                    renderFileBrowser();
                }
            });
        });

        container.querySelectorAll('[data-fb-view]').forEach(el => {
            el.addEventListener('click', (ev) => {
                ev.stopPropagation();
                openImageViewer(el.dataset.fbView);
            });
        });

        container.querySelectorAll('[data-fb-replace]').forEach(btn => {
            btn.addEventListener('click', () => {
                const oldPath  = btn.dataset.fbReplace;
                const isServer = btn.dataset.fbServer === 'true';
                const tmp = document.createElement('input');
                tmp.type = 'file'; tmp.accept = 'image/*';
                tmp.onchange = async () => {
                    const file = tmp.files[0];
                    if (!file) return;
                    const newExt  = (file.name.split('.').pop() || 'png').toLowerCase().replace(/[^a-z0-9]/g,'') || 'png';
                    const base    = oldPath.replace(/\.[^.]+$/, '');
                    const newPath = `${base}.${newExt}`;
                    pushUndo();
                    if (oldPath !== newPath && !isServer) {
                        delete assetBinaryFiles[oldPath];
                        if (assetBlobUrls[oldPath]) { URL.revokeObjectURL(assetBlobUrls[oldPath]); delete assetBlobUrls[oldPath]; }
                    }
                    assetBinaryFiles[newPath] = new Uint8Array(await file.arrayBuffer());
                    if (assetBlobUrls[newPath]) URL.revokeObjectURL(assetBlobUrls[newPath]);
                    assetBlobUrls[newPath] = URL.createObjectURL(new Blob([assetBinaryFiles[newPath]], { type: assetMime(newPath) }));
                    assetStateTouched = true;
                    for (const r of assetRefreshers) r();
                    injectAssetsCss();
                    markModified(true);
                    renderFileBrowser();
                };
                tmp.click();
            });
        });
    }

    // ─── Fullscreen editor modal ──────────────────────────────
    function updateEmHighlight() {
        const ta   = document.getElementById('sl-em-textarea');
        const pre  = document.getElementById('sl-em-highlight');
        const code = pre.querySelector('code');
        const path = document.getElementById('sl-em-filename').textContent;
        code.className = path.endsWith('.js') ? 'language-javascript' : 'language-css';
        code.removeAttribute('data-highlighted');
        code.textContent = ta.value;
        hljs.highlightElement(code);
        pre.scrollTop  = ta.scrollTop;
        pre.scrollLeft = ta.scrollLeft;
    }

    function openEditorModal(path) {
        if (!path || themeFiles[path] === undefined) return;
        const ta = document.getElementById('sl-em-textarea');
        const isJs = path.endsWith('.js');
        document.getElementById('sl-em-filename').textContent = path;
        document.getElementById('btn-em-action').textContent = isJs ? (T.save_js || 'Save JS') : (T.apply_css || 'Apply CSS');
        document.getElementById('sl-em-modified').style.display = 'none';
        document.getElementById('sl-em-status').textContent = '';
        ta.value = themeFiles[path];
        document.getElementById('sl-em-css-btns').style.display = isJs ? 'none' : '';
        document.getElementById('sl-editor-modal').style.display = 'flex';
        updateEmHighlight();
        ta.focus();
    }

    function closeEditorModal() {
        const modal = document.getElementById('sl-editor-modal');
        if (modal.style.display === 'none') return;
        const path  = document.getElementById('sl-em-filename').textContent;
        const ta    = document.getElementById('sl-em-textarea');
        themeFiles[path] = ta.value;
        const panelTa = document.getElementById('sl-css-textarea');
        if (activeCssFile === path) {
            panelTa.value = ta.value;
            markModified(ta.value !== originalCss);
            updateHighlight();
        }
        modal.style.display = 'none';
    }

    function wireEditorModal() {
        const ta  = document.getElementById('sl-em-textarea');
        const pre = document.getElementById('sl-em-highlight');

        ta.addEventListener('input', () => {
            const path = document.getElementById('sl-em-filename').textContent;
            document.getElementById('sl-em-modified').style.display =
                ta.value !== (themeFiles[path] ?? '') ? '' : 'none';
            updateEmHighlight();
        });

        ta.addEventListener('scroll', () => {
            pre.scrollTop  = ta.scrollTop;
            pre.scrollLeft = ta.scrollLeft;
        });

        document.getElementById('btn-em-action').addEventListener('click', () => {
            const path = document.getElementById('sl-em-filename').textContent;
            const isJs = path.endsWith('.js');
            themeFiles[path] = ta.value;
            document.getElementById('sl-em-modified').style.display = 'none';
            if (isJs) {
                document.getElementById('sl-em-status').textContent = T.js_saved || 'Saved';
            } else if (previewReady) {
                injectEditorCss(ta.value);
                document.getElementById('sl-em-status').textContent = T.css_applied || 'Applied';
            }
        });

        document.getElementById('btn-em-close').addEventListener('click', closeEditorModal);

        ta.addEventListener('keydown', e => {
            if (e.key === 'Escape') { closeEditorModal(); return; }
            if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                e.preventDefault();
                document.getElementById('btn-em-action').click();
            }
            if (e.key === 'Tab') {
                e.preventDefault();
                const s = ta.selectionStart, end = ta.selectionEnd;
                ta.value = ta.value.slice(0, s) + '    ' + ta.value.slice(end);
                ta.selectionStart = ta.selectionEnd = s + 4;
                updateEmHighlight();
            }
        });

        document.getElementById('btn-em-reset-css').addEventListener('click', () => {
            ta.value = originalCss;
            document.getElementById('sl-em-modified').style.display = 'none';
            updateEmHighlight();
            const path = document.getElementById('sl-em-filename').textContent;
            if (activeCssFile === path) {
                document.getElementById('sl-css-textarea').value = originalCss;
                markModified(false);
                updateHighlight();
            }
            if (previewReady) injectEditorCss(originalCss);
            setStatus(T.css_reset);
        });

        document.getElementById('btn-em-wrap-scope').addEventListener('click', () => {
            const classes = getScopeClasses();
            if (classes.length === 0 || classes.length === SCOPE_ALL.length) {
                setStatus(T.scope_all);
                return;
            }
            const start = ta.selectionStart, end = ta.selectionEnd;
            const selected = ta.value.substring(start, end).trim();
            if (!selected) { setStatus(T.select_css_first); return; }
            const wrapped = buildScopeWrapped(selected);
            ta.setRangeText(wrapped, start, end, 'select');
            document.getElementById('sl-em-modified').style.display = '';
            updateEmHighlight();
            setStatus(T.wrapped);
        });

        document.getElementById('btn-open-editor-modal').addEventListener('click', () => {
            openEditorModal(activeCssFile);
        });
    }

    // ─── Image viewer ─────────────────────────────────────────
    function openImageViewer(path) {
        const viewer = document.getElementById('sl-img-viewer');
        const img    = document.getElementById('sl-img-viewer-img');
        const label  = document.getElementById('sl-img-viewer-label');
        // Use blob URL if in memory; otherwise load from server theme URL
        let src = assetBlobUrls[path] || null;
        if (!src) {
            const theme = loadedThemes.find(t => t.dirName === document.getElementById('sl-theme').value);
            src = theme?.url ? theme.url + '/' + path : '';
        }
        img.src = src;
        label.textContent = path;
        viewer.style.display = 'flex';
    }
    function wireImageViewer() {
        const viewer = document.getElementById('sl-img-viewer');
        viewer.addEventListener('click', () => { viewer.style.display = 'none'; });
        document.getElementById('sl-img-viewer-close').addEventListener('click', (e) => {
            e.stopPropagation(); viewer.style.display = 'none';
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && viewer.style.display !== 'none') viewer.style.display = 'none';
        });
    }

    function removeAsset(path) {
        const prefix = path.replace(/\.[^.]+$/, '.');
        const removeBtnId = ASSET_REMOVE_BTNS[prefix];
        if (removeBtnId) {
            document.getElementById(removeBtnId)?.click();
        } else {
            // Icon or unregistered asset
            pushUndo();
            delete assetBinaryFiles[path];
            if (assetBlobUrls[path]) { URL.revokeObjectURL(assetBlobUrls[path]); delete assetBlobUrls[path]; }
            assetStateTouched = true;
            injectAssetsCss();
            markModified(true);
            renderFileBrowser();
        }
    }

    // ─── Font helpers ─────────────────────────────────────────
    function isFontFileName(n) { const l=n.toLowerCase(); return l.endsWith('.woff')||l.endsWith('.woff2')||l.endsWith('.ttf')||l.endsWith('.otf'); }
    function safeFileName(name) { return String(name||'').replace(/[/\\]/g,'_').replace(/[^\w.\- ]/g,'_').trim(); }
    function quoteFontFamily(name) { return `"${String(name||'').replace(/\\/g,'\\\\').replace(/"/g,'\\"')}"`; }
    function normalizeFontFamilyFromFileName(fileName) {
        const base = fileName.replace(/\.[^.]+$/,'');
        const cleaned = base.replace(/[_-]+/g,' ').replace(/\b(thin|extralight|ultralight|light|regular|book|normal|medium|semibold|demibold|bold|extrabold|ultrabold|black|heavy|italic|oblique)\b/gi,' ').replace(/\s+/g,' ').trim();
        return cleaned || base;
    }
    function fontWeightFromFileName(f) {
        const l=f.toLowerCase();
        if(/\bthin\b/.test(l)) return 100;
        if(/\b(extralight|ultralight)\b/.test(l)) return 200;
        if(/\blight\b/.test(l)) return 300;
        if(/\bmedium\b/.test(l)) return 500;
        if(/\b(semibold|demibold)\b/.test(l)) return 600;
        if(/\bbold\b/.test(l)) return 700;
        if(/\b(extrabold|ultrabold)\b/.test(l)) return 800;
        if(/\b(black|heavy)\b/.test(l)) return 900;
        return 400;
    }
    function fontStyleFromFileName(f) { return /\b(italic|oblique)\b/i.test(f)?'italic':'normal'; }
    function fontFormatFromFileName(f) {
        const l=f.toLowerCase();
        if(l.endsWith('.woff2')) return 'woff2';
        if(l.endsWith('.woff')) return 'woff';
        if(l.endsWith('.ttf')) return 'truetype';
        if(l.endsWith('.otf')) return 'opentype';
        return '';
    }
    function buildFontFaceRule(fileName) {
        const family = normalizeFontFamilyFromFileName(fileName);
        const weight = fontWeightFromFileName(fileName);
        const style = fontStyleFromFileName(fileName);
        const fmt = fontFormatFromFileName(fileName);
        const src = fmt ? `url(fonts/${fileName}) format("${fmt}")` : `url(fonts/${fileName})`;
        return `@font-face {\n  font-family: ${quoteFontFamily(family)};\n  src: ${src};\n  font-weight: ${weight};\n  font-style: ${style};\n  font-display: swap;\n}`;
    }
    function ensureFontFamilyOption(value, selectId) {
        const sel = document.querySelector(`[data-quick="${selectId}"]`);
        if (!sel || [...sel.options].some(o => o.value === value)) return;
        const opt = document.createElement('option');
        opt.value = value;
        opt.textContent = normalizeFontFamilyFromFileName(value.split(',')[0].replace(/['"]/g,'').trim()) + ' (custom)';
        opt.dataset.custom = '1';
        sel.appendChild(opt);
    }
    function updateFontFamilyOptions() {
        for (const id of ['fontBody','fontTitles']) {
            const sel = document.querySelector(`[data-quick="${id}"]`);
            if (!sel) continue;
            [...sel.options].filter(o => o.dataset.custom).forEach(o => o.remove());
        }
        for (const fontPath of Object.keys(fontBinaryFiles)) {
            const name = fontPath.replace('fonts/','');
            const family = normalizeFontFamilyFromFileName(name);
            const stack = `${quoteFontFamily(family)}, Arial, Verdana, Helvetica, sans-serif`;
            ensureFontFamilyOption(stack, 'fontBody');
            ensureFontFamilyOption(stack, 'fontTitles');
        }
    }
    function rebuildFontFacesInCss() {
        const ta = document.getElementById('sl-css-textarea');
        const cur = ta.value;
        const blockMatch = cur.match(/\/\* custom-fonts:start \*\/[\s\S]*?\/\* custom-fonts:end \*\//i);
        const baseCss = blockMatch ? cur.replace(blockMatch[0],'').replace(/^\n+/,'').trimStart() : cur;
        const fileNames = Object.keys(fontBinaryFiles).map(p => p.replace('fonts/',''));
        if (!fileNames.length) {
            ta.value = baseCss.trimStart();
        } else {
            const rules = fileNames.map(f => buildFontFaceRule(f)).join('\n\n');
            ta.value = `${FONT_BLOCK_START}\n${rules}\n${FONT_BLOCK_END}\n\n${baseCss.trimStart()}`;
        }
        markModified(ta.value !== originalCss);
        updateHighlight();
        if (previewReady) injectEditorCss(ta.value);
    }
    function ensureCustomFontFacesInCss(fileNames) {
        if (!fileNames.length) return [];
        const ta = document.getElementById('sl-css-textarea');
        const cur = ta.value;
        const blockMatch = cur.match(/\/\* custom-fonts:start \*\/[\s\S]*?\/\* custom-fonts:end \*\//i);
        const currentBlock = blockMatch ? blockMatch[0] : '';
        const baseCss = blockMatch ? cur.replace(currentBlock,'').replace(/^\n+/,'').trimStart() : cur;
        const existingUrls = new Set(Array.from(cur.matchAll(/url\(([^)]+)\)/gi)).map(m=>m[1]?.trim().replace(/^['"]|['"]$/g,'')).filter(Boolean));
        const rules = [];
        for (const fileName of fileNames) {
            if (existingUrls.has(`fonts/${fileName}`)) continue;
            rules.push(buildFontFaceRule(fileName));
        }
        const currentRules = currentBlock.replace(/\/\* custom-fonts:start \*\//i,'').replace(/\/\* custom-fonts:end \*\//i,'').trim();
        if (!rules.length) return fileNames.map(f => normalizeFontFamilyFromFileName(f));
        const merged = [currentRules, rules.join('\n\n')].filter(Boolean).join('\n\n');
        ta.value = `${FONT_BLOCK_START}\n${merged}\n${FONT_BLOCK_END}\n\n${baseCss.trimStart()}`;
        markModified(ta.value !== originalCss);
        updateHighlight();
        if (previewReady) injectEditorCss(ta.value);
        return fileNames.map(f => normalizeFontFamilyFromFileName(f));
    }
    function renderFontList() {
        const list = document.getElementById('sl-font-list');
        const paths = Object.keys(fontBinaryFiles);
        if (!paths.length) {
            list.innerHTML = '<span class="sl-font-empty">{{ t.sl_no_custom_fonts or "No custom fonts" }}</span>';
            return;
        }
        list.innerHTML = paths.map(p => {
            const name = p.replace('fonts/','');
            return `<div class="sl-font-item"><span class="sl-font-item-name">${name}</span><button class="sl-font-remove" data-font="${p}" title="Remove">✕</button></div>`;
        }).join('');
        list.querySelectorAll('.sl-font-remove').forEach(btn => {
            btn.addEventListener('click', () => {
                pushUndo();
                const fp = btn.dataset.font;
                const blobUrl = fontBlobUrls[fp];
                if (blobUrl) { URL.revokeObjectURL(blobUrl); delete fontBlobUrls[fp]; }
                delete fontBinaryFiles[fp];
                rebuildFontFacesInCss();
                updateFontFamilyOptions();
                renderFontList();
                injectFontFaces();
                renderFileBrowser();
            });
        });
    }
    function injectFontFaces() {
        if (!previewReady) return;
        for (const url of Object.values(fontBlobUrls)) URL.revokeObjectURL(url);
        fontBlobUrls = {};
        const rules = [];
        for (const [fontPath, bytes] of Object.entries(fontBinaryFiles)) {
            const fileName = fontPath.replace('fonts/','');
            const fmt = fontFormatFromFileName(fileName);
            const mimeMap = { woff2:'font/woff2', woff:'font/woff', truetype:'font/ttf', opentype:'font/otf' };
            const mime = mimeMap[fmt] || 'font/woff2';
            const blob = new Blob([bytes], { type: mime });
            const url = URL.createObjectURL(blob);
            fontBlobUrls[fontPath] = url;
            const family = normalizeFontFamilyFromFileName(fileName);
            const weight = fontWeightFromFileName(fileName);
            const style = fontStyleFromFileName(fileName);
            rules.push(`@font-face { font-family: ${quoteFontFamily(family)}; src: url("${url}") format("${fmt}"); font-weight: ${weight}; font-style: ${style}; font-display: swap; }`);
        }
        injectStyle('sl-font-faces', rules.join('\n'));
    }

    // ─── Asset management ─────────────────────────────────────
    function assetMime(path) {
        const ext = (path.split('.').pop() || '').toLowerCase();
        return { png:'image/png', jpg:'image/jpeg', jpeg:'image/jpeg', gif:'image/gif',
                 webp:'image/webp', svg:'image/svg+xml', ico:'image/x-icon' }[ext] || 'image/png';
    }
    function assetByPrefix(prefix) {
        return Object.keys(assetBinaryFiles).find(p => p.startsWith(prefix)) || null;
    }
    function cssUrlForAsset(path, useBlobUrls = false) {
        return useBlobUrls ? assetBlobUrls[path] : path.replace(/"/g, '\\"');
    }
    function cssClassName(value) {
        return window.CSS?.escape ? CSS.escape(value) : value.replace(/[^a-zA-Z0-9_-]/g, '\\$&');
    }
    function removeAssetByPrefix(prefix) {
        const path = assetByPrefix(prefix);
