            <span id="sl-status" data-testid="style-lab-status">Ready</span>
            <button id="btn-inspect" class="btn button-tertiary" title="{{ t.sl_inspect_title or 'Click-to-edit: click an element in the preview' }}">⊕ {{ t.sl_inspect or 'Inspect' }}</button>
            <button id="btn-undo" class="btn button-tertiary button-square" title="Undo" disabled><span class="auto-icon" aria-hidden="true">undo</span></button>
            <button id="btn-redo" class="btn button-tertiary button-square" title="Redo" disabled><span class="auto-icon" aria-hidden="true">redo</span></button>
            <span class="sl-tb-sep"></span>
            <!-- CSS scope (preview wrapping) -->
            <span class="sl-scope-label">{{ t.sl_scope or 'Scope' }}:</span>
