<!-- ── Click-to-edit modal ── -->
<div id="sl-click-modal" role="dialog" aria-label="{{ t.sl_inspect or 'Click-to-edit' }}">
    <div id="sl-click-modal-header">
        <span>{{ t.sl_edit_element or 'Edit element' }}</span>
        <button id="sl-click-modal-close">×</button>
    </div>
    <div id="sl-click-modal-selector">—</div>
    <div id="sl-click-modal-body">
        <div class="sl-click-row"><label>{{ t.sl_text_color or 'Text color' }}</label><input type="color" id="ce-textColor" value="#333333"></div>
        <div class="sl-click-row"><label>{{ t.sl_content_bg or 'Background' }}</label><input type="color" id="ce-bgColor" value="#ffffff"></div>
        <div class="sl-click-row"><label>{{ t.sl_text_transparency or 'Text transparency (%)' }}</label><input type="number" id="ce-textAlpha" min="0" max="100" step="1" value="0"></div>
        <div class="sl-click-row"><label>{{ t.sl_bg_transparency or 'Background transparency (%)' }}</label><input type="number" id="ce-bgAlpha" min="0" max="100" step="1" value="0"></div>
        <div class="sl-click-row"><label>{{ t.sl_font_size_px or 'Font size (px)' }}</label><input type="number" id="ce-fontSize" min="8" max="96" value="16"></div>
        <div class="sl-click-row">
            <label>{{ t.sl_weight or 'Weight' }}</label>
            <select id="ce-fontWeight">
                <option value="">—</option>
                <option value="400">400</option>
                <option value="600">600</option>
                <option value="700">700</option>
                <option value="800">800</option>
            </select>
        </div>
        <div class="sl-click-row">
            <label>{{ t.sl_alignment or 'Alignment' }}</label>
            <select id="ce-textAlign">
                <option value="">—</option>
                <option value="left">{{ t.sl_align_left or 'Left' }}</option>
                <option value="center">{{ t.sl_align_center or 'Center' }}</option>
                <option value="right">{{ t.sl_align_right or 'Right' }}</option>
                <option value="justify">{{ t.sl_align_justify or 'Justify' }}</option>
            </select>
        </div>
        <div class="sl-click-row"><label>{{ t.sl_margin_left or 'Margin left' }}</label><input type="text" id="ce-marginLeft" placeholder="20px, 5%, auto"></div>
        <div class="sl-click-row"><label>{{ t.sl_margin_right or 'Margin right' }}</label><input type="text" id="ce-marginRight" placeholder="20px, 5%, auto"></div>
        <div class="sl-click-row"><label>{{ t.sl_width or 'Width' }}</label><input type="text" id="ce-width" placeholder="320px, 80%"></div>
        <div class="sl-click-row"><label>{{ t.sl_max_width or 'Max width' }}</label><input type="text" id="ce-maxWidth" placeholder="1100px, 90%"></div>
        <div class="sl-click-row"><label>{{ t.sl_margin_bottom or 'Margin bottom' }}</label><input type="text" id="ce-marginBottom" placeholder="16px, 2%"></div>
        <div class="sl-click-row"><label>{{ t.sl_padding or 'Padding' }}</label><input type="text" id="ce-padding" placeholder="12px, 8px 2%"></div>
        <div class="sl-click-row"><label>{{ t.sl_hover_states or 'Hover/focus/active too' }}</label><input type="checkbox" id="ce-interactiveStates"></div>
    </div>
    <div id="sl-click-modal-footer">
        <button id="btn-click-apply">{{ t.sl_apply_to_css or 'Apply to CSS' }}</button>
        <button id="btn-click-cancel">{{ t.sl_cancel or 'Cancel' }}</button>
    </div>
</div>

<!-- ── Fullscreen editor modal ── -->
<div id="sl-editor-modal" style="display:none;position:fixed;inset:0;z-index:8000;flex-direction:column;background:#fafafa;box-shadow:0 0 0 100vmax rgba(0,0,0,.45);" role="dialog" aria-label="Editor">
    <div id="sl-em-header" style="display:flex;align-items:center;gap:10px;padding:8px 14px;background:#f0f2f5;border-bottom:1px solid #ddd;flex-shrink:0;">
        <span id="sl-em-filename" style="font-family:monospace;font-size:13px;color:#333;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"></span>
        <div id="sl-em-modified" style="width:7px;height:7px;border-radius:50%;background:#e03;display:none;" title="Unsaved changes"></div>
        <span id="sl-em-status" style="font-size:11px;color:var(--muted);"></span>
        <button id="btn-em-action" class="btn button-display" style="font-size:12px;padding:4px 14px;"></button>
        <button id="btn-em-close" class="btn button-tertiary" style="font-size:20px;padding:2px 10px;">×</button>
    </div>
    <div id="sl-em-container" style="flex:1;position:relative;overflow:hidden;background:#fafafa;">
        <pre id="sl-em-highlight" aria-hidden="true" style="position:absolute;inset:0;margin:0;padding:16px 20px;font-family:'Cascadia Code','Fira Code','Consolas',monospace;font-size:13px;line-height:1.65;white-space:pre;tab-size:4;overflow:auto;pointer-events:none;background:transparent;border:none;"><code style="display:block;font-family:inherit;font-size:inherit;background:transparent;"></code></pre>
        <textarea id="sl-em-textarea" spellcheck="false" wrap="off"
            style="position:absolute;inset:0;padding:16px 20px;font-family:'Cascadia Code','Fira Code','Consolas',monospace;font-size:13px;line-height:1.65;color:transparent;background:transparent;caret-color:#1a1a1a;border:none;resize:none;outline:none;overflow:auto;white-space:pre;tab-size:4;z-index:1;"></textarea>
    </div>
    <div style="padding:5px 14px;background:#f0f2f5;border-top:1px solid #ddd;display:flex;align-items:center;gap:8px;flex-shrink:0;">
        <div id="sl-em-css-btns" style="display:flex;gap:6px;">
            <button id="btn-em-reset-css" class="btn button-tertiary" style="font-size:12px;">{{ t.sl_reset_css or 'Reset' }}</button>
            <button id="btn-em-wrap-scope" class="btn button-tertiary" style="font-size:12px;">{{ t.sl_wrap_scope or 'Wrap scope' }}</button>
        </div>
        <div style="flex:1;"></div>
        <span style="font-size:11px;color:#aaa;">Ctrl+S — {{ t.sl_save or 'save / apply' }}</span>
        <span style="font-size:11px;color:#aaa;">Esc — {{ t.sl_close or 'close' }}</span>
        <span style="font-size:11px;color:#aaa;">Tab — 4 {{ t.sl_spaces or 'spaces' }}</span>
    </div>
</div>

