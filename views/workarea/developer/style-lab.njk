    // ─── Theme export / install ───────────────────────────────
    function buildFileOverrides() {
        // Flush current textarea to themeFiles before building overrides
        if (activeCssFile) {
            themeFiles[activeCssFile] = document.getElementById('sl-css-textarea').value;
        }
        // The primary CSS file receives Quick + Asset block merging;
        // other files are included as-is.
        const mainCss = Object.keys(themeFiles).find(p => p === 'style.css')
                     || Object.keys(themeFiles).find(p => p.endsWith('.css'));
        const overrides = {};
        for (const [path, content] of Object.entries(themeFiles)) {
            if (path === mainCss) {
                let css = content;
                // Quick CSS is saved unscoped so it applies to all export types and the editor preview.
                // Scope wrapping is only used for the live Style Lab preview injection.
                const quickCss = buildQuickCss(quickState);
                css = replaceControlledBlock(css, QUICK_BLOCK_START, QUICK_BLOCK_END, quickCss);
                const assetCss = buildAssetsCss(false);
                if (assetStateTouched || assetCss) {
                    css = replaceControlledBlock(css, ASSET_BLOCK_START, ASSET_BLOCK_END, assetCss);
                }
                overrides[path] = css;
            } else {
                overrides[path] = content;
            }
        }
        return overrides;
    }
    window.__styleLabBuildFileOverrides = buildFileOverrides;

    function collectThemeMetadata() {
        return {
            name: document.getElementById('sl-files-dir-name').value.trim(),
            title: document.getElementById('sl-files-display-name').value.trim(),
            version: document.getElementById('sl-files-meta-version').value.trim(),
