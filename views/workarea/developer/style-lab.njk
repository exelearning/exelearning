            <button class="btn button-tertiary sl-vp-btn active" data-viewport="desktop" data-testid="vp-desktop">Desktop</button>
            <button class="btn button-tertiary sl-vp-btn" data-viewport="tablet" data-testid="vp-tablet">Tablet</button>
            <button class="btn button-tertiary sl-vp-btn" data-viewport="mobile" data-testid="vp-mobile">Mobile</button>
            <span class="sl-tb-sep"></span>
            <!-- Export type (same order as Scope chips) -->
            <span class="sl-scope-label">{{ t.sl_preview_as or 'Preview as' }}:</span>
            <button class="btn button-tertiary sl-export-btn active" data-export="html5" data-testid="export-html5">Website</button>
            <button class="btn button-tertiary sl-export-btn" data-export="scorm12" data-testid="export-scorm12">SCORM</button>
            <button class="btn button-tertiary sl-export-btn" data-export="html5-sp" data-testid="export-html5-sp">Single</button>
