    setupAsset({ prefix: 'img/custom-background.',   btnId: 'btn-add-bg-image',       removeId: 'btn-remove-bg-image',       inputId: 'sl-bg-image-input',       nameId: 'sl-bg-image-name',       optionsId: 'sl-bg-image-options' });
    setupAsset({ prefix: 'img/custom-header.',       btnId: 'btn-add-header-image',   removeId: 'btn-remove-header-image',   inputId: 'sl-header-image-input',   nameId: 'sl-header-image-name',   optionsId: 'sl-header-image-options' });
