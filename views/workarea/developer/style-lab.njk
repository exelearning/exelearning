    // ─── Click-to-edit (inspect mode) ────────────────────────
    function injectInspector() {
        const iframe = document.getElementById('sl-iframe');
        try {
            const doc = iframe.contentDocument;
            if (!doc) return;
            const prev = doc.getElementById('__sl_insp');
            if (prev) prev.remove();
            const s = doc.createElement('script');
            s.id = '__sl_insp';
            s.textContent = `(function(){
  window.__slInspect=false;
  var hl=null;
  function sel(el){
    if(el.id) return '#'+CSS.escape(el.id);
    var s=el.tagName.toLowerCase();
    if(el.className&&typeof el.className==='string')
      el.className.trim().split(/\\s+/).forEach(function(c){if(c)s+='.'+CSS.escape(c);});
    return s;
  }
	  document.addEventListener('click',function(e){
	    if(!window.__slInspect)return;
	    e.preventDefault();e.stopPropagation();
	    var cs=window.getComputedStyle(e.target);
	    var tag=(e.target.tagName||'').toLowerCase();
	    var interactive=['a','button','summary','input','select','textarea'].indexOf(tag)!==-1
	      || !!e.target.closest('a,button,summary,[role="button"],#siteNav,.nav-buttons,.box-toggle,.toggler')
	      || (cs.cursor||'').toLowerCase()==='pointer';
	    window.parent.postMessage({type:'SL_CLICK',selector:sel(e.target),
	      textColor:cs.color,bgColor:cs.backgroundColor,
	      fontSize:parseFloat(cs.fontSize)||16,fontWeight:cs.fontWeight,
	      textAlign:cs.textAlign,marginLeft:cs.marginLeft,marginRight:cs.marginRight,
	      width:cs.width,maxWidth:cs.maxWidth,marginBottom:cs.marginBottom,
	      padding:cs.padding,interactive:interactive},'\*');
	  },true);
  document.addEventListener('mouseover',function(e){if(!window.__slInspect)return;e.target.style.outline='2px solid #0ba1a1';},true);
  document.addEventListener('mouseout',function(e){if(!window.__slInspect)return;e.target.style.outline='';},true);
})();`;
            doc.head.appendChild(s);
        } catch(e) { console.warn('[Style Lab] inspector:', e); }
    }

    function rgbToHex(rgb) {
        if (!rgb || rgb === 'transparent') return null;
        const m = rgb.match(/[\d.]+/g);
        if (!m || m.length < 3) return null;
        // fully transparent (alpha = 0) → treat as no color
        if (m.length >= 4 && parseFloat(m[3]) === 0) return null;
        return '#' + m.slice(0,3).map(x => parseInt(x).toString(16).padStart(2,'0')).join('');
    }

    function alphaPercentFromColor(color) {
        const m = String(color || '').match(/[\d.]+/g);
        if (!m || m.length < 4) return 0;
        const alpha = Math.max(0, Math.min(1, parseFloat(m[3])));
        return Math.round((1 - alpha) * 100);
    }

    function colorWithAlpha(hex, transparencyPercent) {
        const clean = String(hex || '').trim();
        const transparency = Math.max(0, Math.min(100, parseFloat(transparencyPercent) || 0));
        if (!/^#[0-9a-f]{6}$/i.test(clean)) return '';
        if (transparency <= 0) return clean;
        const r = parseInt(clean.slice(1, 3), 16);
        const g = parseInt(clean.slice(3, 5), 16);
        const b = parseInt(clean.slice(5, 7), 16);
        const alpha = Math.max(0, Math.min(1, 1 - transparency / 100));
        return `rgba(${r}, ${g}, ${b}, ${alpha.toFixed(2).replace(/0+$/, '').replace(/\.$/, '')})`;
    }

    function sanitizeCssValue(value) {
        const raw = String(value || '').trim();
        if (!raw || /[{};]/.test(raw)) return '';
        if (/url\s*\(|expression\s*\(|javascript:/i.test(raw)) return '';
        return raw;
    }

    function optionalCssValue(id) {
        return sanitizeCssValue(document.getElementById(id).value);
    }

    function expandedClickSelector(selector) {
        const s = String(selector || '').trim();
        if (!s) return '';
        return document.getElementById('ce-interactiveStates').checked
            ? `${s},\n${s}:hover,\n${s}:focus,\n${s}:active`
            : s;
    }

    // ─── Click-edit live preview helpers ─────────────────────
    function buildClickProps() {
        const bgInput = document.getElementById('ce-bgColor');
        const textAlpha = document.getElementById('ce-textAlpha').value;
        const bgAlpha   = document.getElementById('ce-bgAlpha').value;
        return {
            textColor:  document.getElementById('ce-textColor').value,
            bgColor:    bgInput.dataset.skip ? null : bgInput.value,
            fontSize:   document.getElementById('ce-fontSize').value,
            fontWeight: document.getElementById('ce-fontWeight').value,
            textAlign:  document.getElementById('ce-textAlign').value,
            textAlpha,
            bgAlpha,
            extra: {
                'margin-left':   optionalCssValue('ce-marginLeft'),
                'margin-right':  optionalCssValue('ce-marginRight'),
                width:           optionalCssValue('ce-width'),
                'max-width':     optionalCssValue('ce-maxWidth'),
                'margin-bottom': optionalCssValue('ce-marginBottom'),
                padding:         optionalCssValue('ce-padding'),
            },
        };
    }

    function buildClickRuleForSelector(s, props) {
        if (!s) return '';
        let rule = `${s} {\n`;
        if (props.textColor)  rule += `  color: ${colorWithAlpha(props.textColor, props.textAlpha)} !important;\n`;
        if (props.bgColor)    rule += `  background-color: ${colorWithAlpha(props.bgColor, props.bgAlpha)} !important;\n`;
        if (props.fontSize)   rule += `  font-size: ${props.fontSize}px !important;\n`;
        if (props.fontWeight) rule += `  font-weight: ${props.fontWeight} !important;\n`;
        if (props.textAlign)  rule += `  text-align: ${props.textAlign} !important;\n`;
        for (const [prop, value] of Object.entries(props.extra)) {
            if (value) rule += `  ${prop}: ${value} !important;\n`;
        }
        rule += `}`;
        return rule;
    }

    function buildClickRule() {
        const s = expandedClickSelector(clickEditSelector);
        if (!s) return '';
        return buildClickRuleForSelector(s, buildClickProps());
    }

    function injectClickPreview() {
        if (previewReady) injectStyle('sl-click-preview', buildScopeWrapped(buildClickRule()));
    }

    function clearClickPreview() {
        injectStyle('sl-click-preview', '');
    }

    // Live preview on any modal input change
    document.getElementById('ce-bgColor').addEventListener('input', function() {
        delete this.dataset.skip;
        injectClickPreview();
    });
    [
        'ce-textColor', 'ce-textAlpha', 'ce-fontSize', 'ce-fontWeight', 'ce-textAlign',
        'ce-marginLeft', 'ce-marginRight', 'ce-width', 'ce-maxWidth', 'ce-marginBottom',
        'ce-padding', 'ce-interactiveStates'
    ].forEach(id => {
        document.getElementById(id).addEventListener('input', injectClickPreview);
        document.getElementById(id).addEventListener('change', injectClickPreview);
    });

    window.addEventListener('message', e => {
        if (e.data?.type !== 'SL_CLICK') return;
        const {
            selector, textColor, bgColor, fontSize, fontWeight, textAlign,
            marginLeft, marginRight, width, maxWidth, marginBottom, padding,
            interactive
        } = e.data;
        clickEditSelector = selector;
        document.getElementById('sl-click-modal-selector').textContent = selector;
        const textHex = rgbToHex(textColor);
        const bgHex   = rgbToHex(bgColor);
        document.getElementById('ce-textColor').value = textHex || '#333333';
        document.getElementById('ce-textAlpha').value = alphaPercentFromColor(textColor);
        const bgInput = document.getElementById('ce-bgColor');
        bgInput.value = bgHex || '#ffffff';
        bgInput.dataset.skip = bgHex ? '' : '1';
        document.getElementById('ce-bgAlpha').value = alphaPercentFromColor(bgColor);
        document.getElementById('ce-fontSize').value = Math.round(fontSize) || 16;
        document.getElementById('ce-fontWeight').value = ['400','600','700','800'].includes(fontWeight) ? fontWeight : '';
        document.getElementById('ce-textAlign').value = ['left','center','right','justify'].includes(textAlign) ? textAlign : '';
        document.getElementById('ce-marginLeft').value = marginLeft && marginLeft !== '0px' ? marginLeft : '';
        document.getElementById('ce-marginRight').value = marginRight && marginRight !== '0px' ? marginRight : '';
        document.getElementById('ce-width').value = width && width !== 'auto' ? width : '';
        document.getElementById('ce-maxWidth').value = maxWidth && maxWidth !== 'none' ? maxWidth : '';
        document.getElementById('ce-marginBottom').value = marginBottom && marginBottom !== '0px' ? marginBottom : '';
        document.getElementById('ce-padding').value = padding && padding !== '0px' ? padding : '';
        document.getElementById('ce-interactiveStates').checked = Boolean(interactive);
        document.getElementById('sl-click-modal').classList.add('open');
        setInspect(false);
