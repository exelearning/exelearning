                    <button id="btn-files-delete-theme" class="btn button-tertiary" style="display:none;color:#dc3545;border-color:#dc3545;" data-testid="sl-files-delete">
                        <span class="auto-icon" aria-hidden="true">delete</span> {{ t.sl_delete_theme or 'Delete theme' }}
                    </button>
                    <button id="btn-files-reload-theme" class="btn button-tertiary" data-testid="style-lab-reload-theme">↺ {{ t.sl_reload_theme or 'Reload theme from disk' }}</button>
                    <button id="btn-files-discard-back" class="btn button-tertiary" data-testid="style-lab-discard-back" disabled>← {{ t.sl_discard_back or 'Back to editor (discard changes)' }}</button>
