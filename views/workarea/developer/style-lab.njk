        URL.revokeObjectURL(assetBlobUrls[path]);
        delete assetBlobUrls[path];
        delete assetBinaryFiles[path];
    }
    function logoCssPosition(position, mx, my) {
        const x = Math.max(0, mx || 0), y = Math.max(0, my || 0);
        switch (position) {
            case 'top-left':      return `left:${x}px !important;top:${y}px !important;transform:none !important;`;
            case 'top-center':    return `left:50% !important;top:${y}px !important;transform:translateX(-50%) !important;`;
            case 'bottom-left':   return `left:${x}px !important;bottom:${y}px !important;transform:none !important;`;
            case 'bottom-center': return `left:50% !important;bottom:${y}px !important;transform:translateX(-50%) !important;`;
            case 'bottom-right':  return `right:${x}px !important;bottom:${y}px !important;transform:none !important;`;
            default:              return `right:${x}px !important;top:${y}px !important;transform:none !important;`;
        }
    }
    function buildAssetsCss(useBlobUrls = false) {
        let css = '';
        const logo = assetByPrefix('img/custom-logo.');
        const logoEnabled = document.getElementById('sl-logo-enabled');
        if (logo && (!logoEnabled || logoEnabled.checked)) {
            const size     = parseInt(document.getElementById('sl-logo-size').value) || 130;
            const position = document.getElementById('sl-logo-position')?.value || 'top-right';
            const mx       = Math.max(0, parseInt(document.getElementById('sl-logo-margin-x')?.value) || 20);
            const my       = Math.max(0, parseInt(document.getElementById('sl-logo-margin-y')?.value) || 14);
            css += `body::after { content: "" !important; position: fixed !important; width: ${size}px !important; height: ${size}px !important; background: url("${cssUrlForAsset(logo, useBlobUrls)}") no-repeat center / contain !important; ${logoCssPosition(position, mx, my)} z-index: 450 !important; pointer-events: none !important; }\n`;
        }
        const bg = assetByPrefix('img/custom-background.');
        if (bg) {
            const bgRepeat   = document.getElementById('sl-bg-repeat').value || 'no-repeat';
            const bgSoftness = Math.max(0, Math.min(90, parseInt(document.getElementById('sl-bg-softness').value) || 0));
            const bgPos      = (bgRepeat === 'no-repeat') ? 'center center' : 'left top';
            const bgImg      = bgSoftness > 0
                ? `linear-gradient(rgba(255,255,255,${(bgSoftness/100).toFixed(2)}),rgba(255,255,255,${(bgSoftness/100).toFixed(2)})), url("${cssUrlForAsset(bg, useBlobUrls)}")`
                : `url("${cssUrlForAsset(bg, useBlobUrls)}")`;
            css += `body { background-image: ${bgImg} !important; background-repeat: ${bgRepeat} !important; background-position: ${bgPos} !important; background-attachment: fixed !important; }\n`;
        }
        const header = assetByPrefix('img/custom-header.');
        const headerEnabled = document.getElementById('sl-header-enabled');
        if (header && (!headerEnabled || headerEnabled.checked)) {
            const h          = parseInt(document.getElementById('sl-header-image-height').value) || 120;
            const hFit       = document.getElementById('sl-header-image-fit').value || 'cover';
            const hPos       = document.getElementById('sl-header-image-position').value || 'center center';
            const hRepeat    = document.getElementById('sl-header-image-repeat').value || 'no-repeat';
            css += `.exe-content .package-header, #header { background-image: url("${cssUrlForAsset(header, useBlobUrls)}") !important; background-size: ${hFit} !important; background-position: ${hPos} !important; background-repeat: ${hRepeat} !important; height: ${h}px !important; min-height: ${h}px !important; box-sizing: border-box !important; overflow: hidden !important; padding-top: 0 !important; padding-bottom: 0 !important; }\n`;
        }
        const headerHideTitle = document.getElementById('sl-header-hide-title');
        if (headerHideTitle?.checked) {
            css += `.exe-content .package-title, .package-header .package-title, #headerContent { display: none !important; }\n`;
        }
        const footer = assetByPrefix('img/custom-footer.');
        const footerEnabled = document.getElementById('sl-footer-enabled');
        if (footer && (!footerEnabled || footerEnabled.checked)) {
            const h          = parseInt(document.getElementById('sl-footer-image-height').value) || 90;
            const fFit       = document.getElementById('sl-footer-image-fit').value || 'contain';
            const fPos       = document.getElementById('sl-footer-image-position').value || 'center center';
            const fRepeat    = document.getElementById('sl-footer-image-repeat').value || 'no-repeat';
            css += `#siteFooter, #siteFooterContent { background-image: url("${cssUrlForAsset(footer, useBlobUrls)}") !important; background-size: ${fFit} !important; background-position: ${fPos} !important; background-repeat: ${fRepeat} !important; height: ${h}px !important; min-height: ${h}px !important; }\n`;
        }
        const navPrev = assetByPrefix('img/custom-nav-prev.');
        if (navPrev) css += `.nav-buttons .nav-button-left { background-image: url("${cssUrlForAsset(navPrev, useBlobUrls)}") !important; }\n`;
        const navNext = assetByPrefix('img/custom-nav-next.');
        if (navNext) css += `.nav-buttons .nav-button-right { background-image: url("${cssUrlForAsset(navNext, useBlobUrls)}") !important; }\n`;
        const navToggle = assetByPrefix('img/custom-nav-toggle.');
        if (navToggle) css += `#siteNavToggler { background-image: url("${cssUrlForAsset(navToggle, useBlobUrls)}") !important; }\n`;
        for (const [path] of Object.entries(assetBinaryFiles)) {
            if (!path.startsWith('icons/')) continue;
            const name = cssClassName(path.replace('icons/', '').replace(/\.[^.]+$/, ''));
            css += `.iDevice.${name} .iDevice_header, .iDevice.${name}_idevice .iDevice_header { background-image: url("${cssUrlForAsset(path, useBlobUrls)}") !important; }\n`;
        }
        return css.trim();
    }
    function injectAssetsCss() {
        if (!previewReady) return;
        // Refresh blob URLs
        for (const url of Object.values(assetBlobUrls)) URL.revokeObjectURL(url);
        assetBlobUrls = {};
        for (const [path, bytes] of Object.entries(assetBinaryFiles)) {
            assetBlobUrls[path] = URL.createObjectURL(new Blob([bytes], { type: assetMime(path) }));
        }
        const css = buildAssetsCss(true);
        injectStyle('sl-assets-css', css);
        // Favicon (not CSS — swap the <link> element)
        const favicon = assetByPrefix('img/favicon.');
        const iframeDoc = document.getElementById('sl-iframe').contentDocument;
        if (favicon && iframeDoc) {
            let link = iframeDoc.querySelector('link[rel="icon"], link[rel="shortcut icon"]');
            if (!link) { link = iframeDoc.createElement('link'); link.rel = 'icon'; iframeDoc.head.appendChild(link); }
            link.href = assetBlobUrls[favicon];
        }
    }
    function setupAsset({ prefix, btnId, removeId, inputId, nameId, optionsId = null, accept, logoSizeId = null, ext: fixedExt = null }) {
        const btn    = document.getElementById(btnId);
        const rmBtn  = document.getElementById(removeId);
        const input  = document.getElementById(inputId);
        const nameEl = document.getElementById(nameId);
        const optEl  = optionsId ? document.getElementById(optionsId) : null;
        function refresh() {
            const path = assetByPrefix(prefix);
            nameEl.textContent = path ? path.split('/').pop() : '';
            rmBtn.style.display = path ? '' : 'none';
            if (optEl) optEl.style.display = path ? '' : 'none';
        }
        assetRefreshers.push(refresh);
        btn.addEventListener('click', () => { input.value = ''; input.click(); });
        input.addEventListener('change', async () => {
            const file = input.files[0];
            if (!file) return;
            pushUndo();
            removeAssetByPrefix(prefix);
            const ext = fixedExt || (file.name.split('.').pop() || 'png').toLowerCase().replace(/[^a-z0-9]/g, '') || 'png';
            const path = `${prefix}${ext}`;
            assetBinaryFiles[path] = new Uint8Array(await file.arrayBuffer());
            assetStateTouched = true;
            refresh();
            injectAssetsCss();
            markModified(true);
            renderFileBrowser();
        });
        rmBtn.addEventListener('click', () => {
            pushUndo();
            removeAssetByPrefix(prefix);
            assetStateTouched = true;
            refresh();
            injectAssetsCss();
            markModified(true);
            renderFileBrowser();
        });
        if (logoSizeId) {
            document.getElementById(logoSizeId).addEventListener('input', () => {
                assetStateTouched = true;
                injectAssetsCss();
                markModified(true);
            });
        }
    }
    function setupIdeviceIcons() {
