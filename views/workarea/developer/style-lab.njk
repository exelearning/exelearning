                        </div>
                        <div class="sl-rename-row">
                            <label for="sl-files-meta-compatibility">{{ t.sl_compatibility or 'Compatibility' }}</label>
                            <input type="text" id="sl-files-meta-compatibility" placeholder="3.0" maxlength="32">
                        </div>
                    </div>
                    <div class="sl-rename-grid">
                        <div class="sl-rename-row">
                            <label for="sl-files-meta-author">{{ t.sl_author or 'Author' }}</label>
                            <input type="text" id="sl-files-meta-author" maxlength="128">
                        </div>
                        <div class="sl-rename-row">
                            <label for="sl-files-meta-downloadable">{{ t.sl_importable or 'Importable' }}</label>
                            <select id="sl-files-meta-downloadable">
                                <option value="1">{{ t.sl_yes or 'Yes' }}</option>
                                <option value="0">{{ t.sl_no or 'No' }}</option>
                            </select>
                        </div>
                    </div>
                    <div class="sl-rename-row">
                        <label for="sl-files-meta-license">{{ t.sl_license or 'License' }}</label>
                        <input type="text" id="sl-files-meta-license" maxlength="128">
                    </div>
                    <div class="sl-rename-row">
                        <label for="sl-files-meta-license-url">{{ t.sl_license_url or 'License URL' }}</label>
                        <input type="url" id="sl-files-meta-license-url" maxlength="256">
                    </div>
                    <div class="sl-rename-row">
                        <label for="sl-files-meta-description">{{ t.sl_description or 'Description' }}</label>
