    const ASSET_BLOCK_END = '/* style-lab-assets:end */';
    let fontBinaryFiles = {};   // "fonts/name.woff2" → Uint8Array
    let fontBlobUrls = {};      // "fonts/name.woff2" → object URL (for live preview)
    let assetBinaryFiles = {};  // "img/custom-logo.png" → Uint8Array
    let assetBlobUrls = {};     // "img/custom-logo.png" → object URL (for live preview)
    let swRegistration = null;
    let previewReady = false;
    let selectedExport = 'html5';
    let loadedThemes = [];
    let loadedSessions = [];    // sessions with theme info
