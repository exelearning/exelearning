    function uint8ToBase64(bytes) {
        let bin = '';
        const chunk = 8192;
        for (let i = 0; i < bytes.length; i += chunk) {
            bin += String.fromCharCode(...bytes.subarray(i, i + chunk));
        }
        return btoa(bin);
    }
    async function onFontsSelected(fileList) {
        const files = Array.from(fileList || []).filter(f => isFontFileName(f.name));
        if (!files.length) { setStatus(T.no_valid_fonts); return; }
        pushUndo();
        const addedNames = [];
        for (const file of files) {
            const name = safeFileName(file.name);
            if (!name) continue;
            fontBinaryFiles[`fonts/${name}`] = new Uint8Array(await file.arrayBuffer());
            addedNames.push(name);
        }
        if (!addedNames.length) return;
        const families = ensureCustomFontFacesInCss(addedNames);
        for (const family of families) {
            const stack = `${quoteFontFamily(family)}, Arial, Verdana, Helvetica, sans-serif`;
            ensureFontFamilyOption(stack, 'fontBody');
            ensureFontFamilyOption(stack, 'fontTitles');
        }
        renderFontList();
        injectFontFaces();
        setStatus(T.fonts_added.replace('{n}', addedNames.length));
        renderFileBrowser();
    }
