                <input type="checkbox" value="exe-web-site" checked> Website
            </label>
            <label class="sl-scope-chip checked" data-scope="exe-scorm">
                <input type="checkbox" value="exe-scorm" checked> SCORM
            </label>
            <label class="sl-scope-chip checked" data-scope="exe-single-page">
