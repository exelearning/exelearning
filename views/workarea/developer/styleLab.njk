<!doctype html>
<html lang="{{ locale or 'en' }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'Style Lab' | trans }} · eXeLearning</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/app/workarea/developer/assets/tokens.css' | asset }}">
    <link rel="stylesheet" href="{{ '/app/workarea/developer/assets/topbar.css' | asset }}">
    <link rel="stylesheet" href="{{ '/app/workarea/developer/assets/sidebar.css' | asset }}">
    <link rel="stylesheet" href="{{ '/app/workarea/developer/assets/themes.css' | asset }}">
    <link rel="stylesheet" href="{{ '/app/workarea/developer/assets/canvas.css' | asset }}">
    <link rel="stylesheet" href="{{ '/app/workarea/developer/assets/misc.css' | asset }}">
</head>
<body data-testid="style-lab-page">
    <div id="icon-sprite-host"></div>

    <header class="topbar">
        <a href="{{ basePath }}/developer" class="brand">
            <span class="brand-mark"><svg viewBox="0 0 285 270" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-label="eXeLearning"><path d="m102.249.584028c9.46 0 19.566 3.440102 30.316 10.320372 10.536 6.6652 25.049 18.4907 43.539 35.4763 31.821-26.661 48.795-32.6665 65.135-32.6665 10.536 0 19.566 2.9026 27.091 8.7078 13.863 10.6007 16.175 34.8103 6.463 50.7272-7.74 12.6855-17.846 26.3385-30.316 40.9588 28.381 32.251 44.233 55.457 44.233 71.368 0 11.395-3.548 20.103-10.643 26.123-7.31 6.02-16.448 9.03-27.413 9.03-16.556 0-42.514-12.562-74.55-39.438-18.275 16.125-32.681 27.306-43.216 33.541-10.751 6.235-20.964 9.353-30.639 9.353-12.9004 0-22.8983-4.193-29.9935-12.578-7.3103-8.601-10.9654-18.706-10.9654-30.316 0-7.526 1.075-14.083 3.2251-19.674 2.1501-5.59 6.1277-11.825 11.9329-18.705 5.8052-7.096 15.0506-16.878 27.7359-29.349-12.2553-12.47-21.2856-22.4682-27.0909-29.9934-6.0202-7.7403-10.1053-14.5131-12.2554-20.3183-2.3651-5.8052-3.5476-12.2554-3.5476-19.3507 0-7.5253 1.6125-14.513 4.8376-20.9632 3.2252-6.6653 7.9553-12.0405 14.1906-16.12565 6.2352-4.08515 13.5455-6.127721 21.9307-6.127722z"/></svg></span>
            Style&nbsp;Lab
            <span class="brand-sub">Beta</span>
        </a>
        <div class="topbar-right"></div>
    </header>

    <main class="workspace" data-base-path="{{ basePath }}" data-testid="style-lab-root">
        <aside class="sidebar">
            <div class="sb-section">
                <div class="sb-section-title">{{ 'Project' | trans }}</div>
                <label class="sb-label">{{ 'Sample project' | trans }}</label>
                <select class="select" id="fixture-select" data-testid="style-lab-fixture-select"></select>
                <div class="sb-help">{{ 'Pick an .elpx fixture to render with the chosen theme. Independent of your open project.' | trans }}</div>
            </div>

            <div class="sb-section">
                <div class="sb-section-title">{{ 'Themes' | trans }} <span class="count" id="theme-count" data-testid="style-lab-theme-count">—</span></div>
                <div class="theme-list" id="theme-list" data-testid="style-lab-theme-list"></div>
            </div>
        </aside>

        <section class="canvas">
            <div class="canvas-toolbar">
                <div class="segmented" id="seg-mode">
                    <button class="is-active" data-value="web" data-testid="style-lab-mode-web"><svg><use href="#icon-page"/></svg>Web</button>
                    <button data-value="single" data-testid="style-lab-mode-single"><svg><use href="#icon-single"/></svg>{{ 'Single' | trans }}</button>
                    <button data-value="scorm" data-testid="style-lab-mode-scorm"><svg><use href="#icon-scorm"/></svg>SCORM</button>
                </div>
                <div class="canvas-title">
                    <svg style="width:14px;height:14px;color:var(--accent)"><use href="#icon-style"/></svg>
                    <span id="ct-theme" data-testid="style-lab-active-theme">—</span>
                    <span class="mode-badge" id="ct-mode" hidden data-testid="style-lab-active-mode"></span>
                </div>
                <div class="canvas-actions">
                    <div class="segmented" id="seg-layout">
                        <button data-value="desktop" data-testid="style-lab-viewport-desktop"><svg><use href="#icon-desktop"/></svg>{{ 'Desktop' | trans }}</button>
                        <button data-value="mobile" data-testid="style-lab-viewport-mobile"><svg><use href="#icon-mobile"/></svg>{{ 'Mobile' | trans }}</button>
                        <button class="is-active" data-value="split" data-testid="style-lab-viewport-split"><svg><use href="#icon-split"/></svg>{{ 'Both' | trans }}</button>
                    </div>
                    <button class="icon-btn" id="btn-refresh" title="{{ 'Refresh' | trans }}" data-testid="style-lab-refresh"><svg><use href="#icon-refresh"/></svg></button>
                </div>
            </div>

            <div class="canvas-body" data-layout="split" id="canvas-body">
                <div class="frame-desktop-wrap">
                    <div class="preview-label">
                        <svg><use href="#icon-desktop"/></svg> Desktop
                        <span class="res">1024 × 640</span>
                    </div>
                    <div class="frame-desktop">
                        <div class="frame-desktop-bar">
                            <span class="frame-dot r"></span><span class="frame-dot y"></span><span class="frame-dot g"></span>
                            <div class="frame-url"><svg><use href="#icon-lock"/></svg> preview.local</div>
                        </div>
                        <iframe class="frame-desktop-screen" id="preview-desktop" data-testid="style-lab-preview-desktop" src="about:blank"></iframe>
                    </div>
                </div>

                <div class="frame-mobile-wrap">
                    <div class="preview-label">
                        <svg><use href="#icon-mobile"/></svg> Mobile
                        <span class="res">375 × 812</span>
                    </div>
                    <div class="frame-mobile">
                        <iframe class="frame-mobile-screen" id="preview-mobile" data-testid="style-lab-preview-mobile" src="about:blank"></iframe>
                    </div>
                </div>
            </div>

            <div id="canvas-empty" data-testid="style-lab-empty" hidden></div>
        </section>
    </main>

    <script type="module" src="{{ '/app/workarea/developer/styleLab.js' | asset }}"></script>
</body>
</html>
