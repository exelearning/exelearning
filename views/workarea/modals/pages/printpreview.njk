<!-- Print Preview Overlay (not using Bootstrap modal) -->
<div id="printPreviewOverlay" class="print-preview-overlay" data-visible="false" data-busy="false">
    <div class="print-preview-header d-flex justify-content-between align-items-center p-2 border-bottom">
        <div class="print-preview-title h5 mb-0">
            <span class="print-preview-title-text">{{ 'Print preview' | trans }}</span>
        </div>
        <div class="print-preview-actions d-flex gap-2">
            <button type="button" class="print-preview-options-btn btn btn-secondary" aria-controls="printOptionsPanel" aria-expanded="false" hidden>
                {{ 'Print options' | trans }}
            </button>
            {# Desktop app only: the script shows it where the app can make a PDF, which needs no printer. #}
            <button type="button" class="print-preview-pdf-btn btn btn-secondary" hidden>
                {{ 'Save as PDF' | trans }}
            </button>
            <button type="button" class="print-preview-print-btn btn btn-primary" title="{{ 'Print' | trans }}">
                {{ 'Print' | trans }}
            </button>
            <button type="button" class="print-preview-close-btn btn btn-secondary" title="{{ 'Close' | trans }}">
                {{ 'Close' | trans }}
            </button>
        </div>
    </div>
    {# Shown by the script when printing did not start, or the PDF could not be saved; one message at a time. #}
    <div class="print-preview-notice" role="alert" hidden>
        <p class="print-preview-notice-text" data-notice="not-started">{{ 'Printing did not start. Printing may be disabled in this browser or on this device.' | trans }}</p>
        <p class="print-preview-notice-text" data-notice="pdf-failed" hidden>{{ 'The PDF could not be saved.' | trans }}</p>
        <button type="button" class="print-preview-open-tab-btn btn btn-secondary btn-sm">{{ 'Open in a new tab' | trans }}</button>
        <button type="button" class="print-preview-notice-pdf-btn btn btn-secondary btn-sm" hidden>{{ 'Save as PDF' | trans }}</button>
    </div>
    <div class="print-preview-body">
        <div class="print-preview-content">
            <div class="print-preview-loading">
                <div class="spinner-border" role="status"></div>
                <p>{{ 'Generating preview...' | trans }}</p>
            </div>
            {# The name lets the desktop app find this frame to make a PDF of it. #}
            <iframe class="print-preview-iframe" name="exe-print-preview" title="{{ 'Print preview' | trans }}"></iframe>
        </div>
        {# The options that change what the preview shows, one section under another: the document options, always there, then what to print and which activities, which the script fills in when the project has any. #}
        <aside id="printOptionsPanel" class="print-options-panel" aria-labelledby="printOptionsTitle" hidden>
            <div class="print-options-header">
                <h2 id="printOptionsTitle" class="print-options-title">{{ 'Print options' | trans }}</h2>
                <button type="button" class="print-options-close" aria-label="{{ 'Close' | trans }}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M15 5L5 15M5 5L15 15" stroke="black" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            </div>
            <div class="print-options-body">
                <fieldset class="print-options-group print-options-document">
                    <legend class="print-options-group-title">{{ 'Document' | trans }}</legend>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="printOptLinkUrls" checked>
                        <label class="form-check-label" for="printOptLinkUrls">{{ 'Show link URLs' | trans }}</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="printOptUnfoldBlocks">
                        <label class="form-check-label" for="printOptUnfoldBlocks">{{ 'Print all visible content' | trans }}</label>
                    </div>
                    {# Shown by the script only when the project has activities that can never be printed. #}
                    <div class="form-check" hidden>
                        <input class="form-check-input" type="checkbox" id="printOptUnprintableTitles">
                        <label class="form-check-label" for="printOptUnprintableTitles">{{ 'Show titles of non-printable activities' | trans }}</label>
                    </div>
                </fieldset>
                <div class="print-options-activities" hidden></div>
            </div>
            <p class="print-options-status" role="status" aria-live="polite"></p>
        </aside>
    </div>
</div>
