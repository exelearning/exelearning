<div class="modal exe-modal-fade" tabindex="-1" id="modalManageProjects" role="dialog" aria-hidden="true" data-testid="modal-manage-projects" data-open="false">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down modal-xl modal-confirm" role="document">
        <div class="modal-content" id="modalManageProjectsContent">
            <div class="modal-header">
                <div class="modal-title">{{ 'Manage projects' | trans }}</div>
                <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Close' | trans }}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="modal-body-content"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="move-selected-button btn button-secondary d-none">{{ 'Move to folder' | trans }}</button>
                <button type="button" class="confirm btn btn-primary d-none">{{ 'Delete' | trans }}</button>
                <button type="button" class="close btn btn-secondary" data-dismiss="modal">{{ 'Close' | trans }}</button>
            </div>
        </div>
    </div>
</div>
