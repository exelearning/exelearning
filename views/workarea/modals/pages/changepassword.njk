<div class="modal exe-modal-fade" tabindex="-1" id="modalChangePassword" role="dialog" aria-hidden="true" data-testid="modal-change-password" data-open="false">
    <div class="modal-dialog modal-dialog-centered modal-change-password" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title">{{ 'Change password' | trans }}</div>
                <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Close' | trans }}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="change-password-form" autocomplete="off" novalidate>
                    {# Feedback for both validation and API errors. Announced to
                       assistive tech; never contains any password value. #}
                    <div class="change-password-feedback alert d-none" role="alert" aria-live="polite" data-testid="change-password-feedback"></div>
                    <div class="mb-3">
                        <label class="form-label" for="change-password-current">{{ 'Current password' | trans }}</label>
                        <input type="password" class="form-control" id="change-password-current" name="currentPassword" autocomplete="current-password" required data-testid="change-password-current">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="change-password-new">{{ 'New password' | trans }}</label>
                        <input type="password" class="form-control" id="change-password-new" name="newPassword" autocomplete="new-password" required aria-describedby="change-password-hint change-password-strength" data-testid="change-password-new">
                        <div class="form-text" id="change-password-hint">{{ 'At least 4 characters. Longer passwords that mix letters, numbers and symbols are safer.' | trans }}</div>
                        {# Advisory strength indicator: it never blocks the change. #}
                        <div class="change-password-strength d-none" id="change-password-strength" data-testid="change-password-strength">
                            <div class="progress" role="presentation">
                                <div class="progress-bar change-password-strength-bar" style="width: 0%;"></div>
                            </div>
                            <small class="change-password-strength-label" role="status" aria-live="polite"></small>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="change-password-confirm">{{ 'Confirm new password' | trans }}</label>
                        <input type="password" class="form-control" id="change-password-confirm" name="confirmPassword" autocomplete="new-password" required data-testid="change-password-confirm">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="cancel btn button-tertiary" data-dismiss="modal" data-testid="change-password-cancel">{{ 'Cancel' | trans }}</button>
                <button type="button" class="change-password-submit btn button-primary" data-testid="change-password-submit">{{ 'Change password' | trans }}</button>
            </div>
        </div>
    </div>
</div>
