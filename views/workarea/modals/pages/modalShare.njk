{# Share Modal - Google Docs-style project sharing interface #}
<div class="modal exe-modal-fade" tabindex="-1" id="modalShare" role="dialog" data-open="false">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalShareTitle"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Close' | trans }}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                {# Invite Section #}
                <div id="share-invite-section" class="mb-4">
                    <div class="input-group">
                        <input type="email"
                               id="share-invite-email"
                               class="form-control"
                               placeholder="{{ 'Add people by email' | trans }}"
                               aria-label="{{ 'Add people by email' | trans }}"
                               autocomplete="off">
                        <button id="share-invite-button"
                                class="btn btn-primary"
                                type="button">
                            {{ 'Invite' | trans }}
                        </button>
                    </div>
                    <div id="share-invite-error" class="invalid-feedback d-none"></div>
                </div>

                {# People with Access Section #}
                <div id="share-people-section" class="mb-4">
                    <h6>{{ 'People with access' | trans }}</h6>
                    <div id="share-people-list"></div>
                </div>

                {# Edit Access Card #}
                <div id="share-edit-access-section" class="share-access-card share-access-card-edit mb-3">
                    <div class="share-access-card-header">
                        <img id="share-visibility-icon"
                             class="share-access-card-icon"
                             src="{{ basePath }}/style/workarea/images/icons/exe-lock-icon-green.svg"
                             alt=""
                             width="20"
                             height="20"
                             aria-hidden="true">
                        <h6>{{ 'Edit access' | trans }}</h6>
                    </div>
                    <select id="share-visibility-select"
                            class="form-select"
                            aria-label="{{ 'Edit access' | trans }}"
                            data-icon-private="{{ basePath }}/style/workarea/images/icons/exe-lock-icon-green.svg"
                            data-icon-public="{{ basePath }}/style/workarea/images/icons/exe-globe-icon-green.svg">
                        <option value="private">{{ 'Only invited people' | trans }}</option>
                        <option value="public">{{ 'Anyone with the edit link' | trans }}</option>
                    </select>
                    <small id="share-visibility-help" class="form-text text-muted">
                        {{ 'Only the people added above can open and edit this resource.' | trans }}
                    </small>

                    <label class="share-access-link-label">{{ 'Edit link' | trans }}</label>
                    <div class="input-group">
                        <input type="text"
                               id="share-link-input"
                               class="form-control"
                               readonly
                               aria-label="{{ 'Edit link' | trans }}">
                        <button id="share-copy-button"
                                class="btn btn-outline-secondary"
                                type="button"
                                aria-label="{{ 'Copy link' | trans }}">
                            <div class="auto-icon" aria-hidden="true">content_copy</div>
                            <span>{{ 'Copy' | trans }}</span>
                        </button>
                    </div>
                </div>

                {# Public Read-Only Link Card #}
                <div id="share-public-view-section" class="share-access-card share-access-card-view mb-3">
                    <div class="share-access-card-header">
                        <img class="share-access-card-icon"
                             src="{{ basePath }}/style/workarea/images/icons/exe-globe-icon-green.svg"
                             alt=""
                             width="20"
                             height="20"
                             aria-hidden="true">
                        <h6>{{ 'Public read-only link' | trans }}</h6>
                    </div>
                    <select id="share-public-view-select"
                            class="form-select"
                            aria-label="{{ 'Public read-only link' | trans }}">
                        <option value="disabled">{{ 'Disabled' | trans }}</option>
                        <option value="enabled">{{ 'Enabled' | trans }}</option>
                    </select>
                    <small id="share-public-view-help" class="form-text text-muted">
                        {{ 'This resource has no public read-only link.' | trans }}
                    </small>

                    <div id="public-link-section" class="d-none">
                        <label class="share-access-link-label">{{ 'Public link' | trans }}</label>
                        <div class="input-group">
                            <input type="text"
                                   id="public-link-input"
                                   class="form-control"
                                   readonly
                                   aria-label="{{ 'Public viewer link' | trans }}">
                            <button id="public-copy-button"
                                    class="btn btn-outline-secondary"
                                    type="button"
                                    aria-label="{{ 'Copy link' | trans }}">
                                <div class="auto-icon" aria-hidden="true">content_copy</div>
                                <span>{{ 'Copy' | trans }}</span>
                            </button>
                        </div>
                        <button id="public-regenerate-button"
                                class="btn btn-outline-danger btn-sm mt-2"
                                type="button">
                            <div class="auto-icon" aria-hidden="true">autorenew</div>
                            <span>{{ 'Regenerate link' | trans }}</span>
                        </button>

                        {# Inline confirmation, kept inside this modal so it never closes it #}
                        <div id="public-regenerate-confirm" class="d-none" role="alertdialog" aria-live="polite">
                            <span class="public-regenerate-confirm-text">
                                {{ 'Regenerate the public link? The previous link will stop working.' | trans }}
                            </span>
                            <div class="public-regenerate-confirm-actions">
                                <button id="public-regenerate-confirm-yes"
                                        class="btn btn-danger btn-sm"
                                        type="button">
                                    {{ 'Yes, regenerate' | trans }}
                                </button>
                                <button id="public-regenerate-confirm-no"
                                        class="btn btn-outline-secondary btn-sm"
                                        type="button">
                                    {{ 'Cancel' | trans }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                {# ARIA Live Region for announcements #}
                <div id="share-aria-live"
                     class="visually-hidden"
                     aria-live="polite"
                     aria-atomic="true"></div>
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary close"
                        data-dismiss="modal">
                    {{ 'Done' | trans }}
                </button>
            </div>
        </div>
    </div>
</div>
