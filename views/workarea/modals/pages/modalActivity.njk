{# Activity Modal - per-project activity log (issue #2689) #}
<div class="modal exe-modal-fade" tabindex="-1" id="modalActivity" role="dialog" data-open="false" aria-labelledby="modalActivityTitle">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalActivityTitle"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Close' | trans }}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p class="activity-modal-intro text-muted">
                    {{ 'Who shared, opened, saved, edited or imported content in this project, and when.' | trans }}
                </p>
                <div id="activity-log-container"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="activity-back-button">
                    {{ 'Back to sharing' | trans }}
                </button>
                <button type="button" class="btn btn-primary close" data-dismiss="modal">
                    {{ 'Done' | trans }}
                </button>
            </div>
        </div>
    </div>
</div>
