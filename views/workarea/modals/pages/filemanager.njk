<div class="modal exe-modal-fade" tabindex="-1" id="modalFileManager" role="dialog" aria-hidden="true" data-testid="modal-filemanager" data-open="false">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down modal-xl modal-confirm" role="document">
        <div class="modal-content" id="modalFileManagerContent">
            <div class="modal-header">
                <div class="modal-title">{{ 'File manager' | trans }}</div>
                <div class="media-library-header-search d-none d-md-block">
                    <input type="search" class="form-control media-library-search" placeholder="{{ 'Search by name, title, description, author or license' | trans }}">
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Close' | trans }}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body media-library-body">
                <div class="media-library-toolbar">
                    <button type="button" class="btn btn-primary media-library-upload-btn">
                        <span class="exe-icon">add</span> {{ 'Add files' | trans }}
                    </button>
                    <button type="button" class="btn btn-secondary media-library-newfolder-btn" title="{{ 'New folder' | trans }}">
                        <span class="exe-icon">create_new_folder</span>
                    </button>
                    <input type="file" class="media-library-upload-input" accept="image/*,video/*,audio/*,.pdf,.zip,.gz,.tgz,.tar,.tar.gz,.elp,.elpx,.glb,.gltf,.stl,.obj,.fbx,.3ds,.pdb,.sdf,.mol2,.xyz,.cif,.mmcif,.mmtf,.gro,.pqr,.prmtop,.vasp,.cube,.srt,.vtt" multiple style="display:none;">
                    <input type="file" class="media-library-replace-input" aria-label="{{ 'Select replacement file' | trans }}" style="display:none;">


                    <div class="media-library-view-controls">
                        <button type="button" class="media-library-view-btn active" data-view="grid" title="{{ 'Grid view' | trans }}">
                            <span class="exe-icon">grid_view</span>
                        </button>
                        <button type="button" class="media-library-view-btn" data-view="list" title="{{ 'List view' | trans }}">
                            <span class="exe-icon">view_list</span>
                        </button>
                    </div>

                    <div class="media-library-sort-controls d-none d-md-flex">
                        <label>{{ 'Sort' | trans }}:</label>
                        <select class="form-select media-library-sort">
                            <option value="date-desc" selected>{{ 'Newest first' | trans }}</option>
                            <option value="date-asc">{{ 'Oldest first' | trans }}</option>
                            <option value="name-asc">{{ 'Name A-Z' | trans }}</option>
                            <option value="name-desc">{{ 'Name Z-A' | trans }}</option>
                            <option value="size-desc">{{ 'Largest first' | trans }}</option>
                            <option value="size-asc">{{ 'Smallest first' | trans }}</option>
                            <option value="type-asc">{{ 'Type A-Z' | trans }}</option>
                            <option value="type-desc">{{ 'Type Z-A' | trans }}</option>
                            <option value="references-desc">{{ 'References: most used first' | trans }}</option>
                            <option value="references-asc">{{ 'References: least used first' | trans }}</option>
                        </select>
                    </div>

                    <div class="media-library-filter-controls d-none d-md-flex">
                        <label>{{ 'Type' | trans }}:</label>
                        <select class="form-select media-library-filter">
                            <option value="">{{ 'All' | trans }}</option>
                        </select>
                    </div>

                    <div class="media-library-file-count text-muted small ms-auto d-none d-md-block">
                        <span class="media-library-count-value">0</span> {{ 'files' | trans }}
                    </div>
                </div>

                <div class="media-library-container">
                    <div class="media-library-main">
                        <div class="media-library-nav-bar">
                            <div class="media-library-breadcrumbs ps-2">
                                <span class="breadcrumb-item" data-path="" title="{{ 'Root' | trans }}">
                                    <span class="exe-icon">home</span>
                                </span>
                            </div>
                        </div>
                        <div class="media-library-search-indicator ps-2 d-none">
                            <span class="breadcrumb-home exe-icon" title="{{ 'Go to root' | trans }}">home</span>
                            <span class="breadcrumb-separator">/</span>
                            <span>{{ 'Search results for' | trans }}: <strong class="search-term"></strong></span>
                            <button type="button" class="btn btn-sm btn-link clear-search-btn p-0 ms-2" title="{{ 'Clear search' | trans }}">
                                <span class="exe-icon">close</span>
                            </button>
                        </div>
                        <div class="media-library-empty">
                            <p>{{ 'No media files yet' | trans }}</p>
                            <p class="media-library-empty-hint">{{ 'Click "Add files" or drop files here to upload' | trans }}</p>
                        </div>
                        <div class="media-library-grid">
                            <div class="media-library-loading">{{ 'Loading assets...' | trans }}</div>
                        </div>
                        <div class="media-library-list-container" style="display:none;">
                            <table class="media-library-list">
                                <thead>
                                    <tr>
                                        <th class="col-thumb"></th>
                                        <th class="col-name" data-sort="name">{{ 'Name' | trans }}</th>
                                        <th class="col-location d-none">{{ 'Location' | trans }}</th>
                                        <th class="col-type" data-sort="type">{{ 'Type' | trans }}</th>
                                        <th class="col-size" data-sort="size">{{ 'Size' | trans }}</th>
                                        <th class="col-date" data-sort="date">{{ 'Added' | trans }}</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>

                    </div>

                    <div class="media-library-sidebar">
                        <button type="button" class="media-library-sheet-close d-md-none" aria-label="{{ 'Close' | trans }}">
                            <span class="exe-icon" aria-hidden="true">expand_more</span>
                        </button>
                        <div class="media-library-sidebar-empty">
                            <p>{{ 'Select an item to view details' | trans }}</p>
                        </div>
                        <div class="media-library-sidebar-content" style="display:none;">
                            <!-- Compact file header: thumbnail + name + technical summary + preview toggle -->
                            <div class="media-library-file-header">
                                <div class="media-library-header-thumb" aria-hidden="true">
                                    <img src="" alt="" class="media-library-header-thumb-img" style="display:none;">
                                    <span class="exe-icon media-library-header-thumb-icon">description</span>
                                </div>
                                <div class="media-library-header-info">
                                    <p class="media-library-header-name"></p>
                                    <p class="media-library-header-meta"></p>
                                </div>
                                <button type="button" class="media-library-preview-toggle" aria-expanded="false" title="{{ 'Toggle preview' | trans }}" aria-label="{{ 'Toggle preview' | trans }}">
                                    <span class="exe-icon" aria-hidden="true">open_in_full</span>
                                </button>
                            </div>

                            <!-- Large preview: folded away until the user expands it -->
                            <div class="media-library-preview-wrap" hidden>
                                <div class="media-library-preview">
                                    <img src="" alt="" class="media-library-preview-img">
                                    <video src="" class="media-library-preview-video" controls style="display:none;"></video>
                                    <audio src="" class="media-library-preview-audio" controls style="display:none;"></audio>
                                    <div class="media-library-preview-file" style="display:none;">
                                        <span class="exe-icon file-icon">description</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Metadata / Details / Usage tabs (same segmented tab style used across the app) -->
                            <ul class="nav nav-tabs media-library-tabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button type="button" class="nav-link media-library-tab active" data-media-tab="metadata" role="tab" aria-selected="true">{{ 'Metadata' | trans }}</button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button type="button" class="nav-link media-library-tab" data-media-tab="details" role="tab" aria-selected="false">{{ 'Details' | trans }}</button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button type="button" class="nav-link media-library-tab" data-media-tab="usage" role="tab" aria-selected="false">{{ 'Usage' | trans }}<span class="media-library-usage-tab-count"></span></button>
                                </li>
                            </ul>

                            <div class="tab-content media-library-tab-content media-library-metadata">
                                <!-- Editable centralized metadata (autosaved; the caption preview reuses
                                     the shared figure-caption builder so it matches exports). -->
                                <div class="tab-pane active media-library-tab-pane media-library-section-metadata" data-media-pane="metadata" role="tabpanel">
                                    <form class="media-library-edit-metadata" style="display:none;">
                                        <p class="media-library-metadata-hint">{{ 'These details apply to every insertion of the file and build its caption. Changes are saved automatically.' | trans }}</p>
                                        <span class="media-library-meta-status small" role="status" aria-live="polite"></span>
                                        <div class="metadata-row metadata-edit-row">
                                            <label for="media-library-meta-title">{{ 'Name' | trans }}</label>
                                            <input type="text" id="media-library-meta-title" class="form-control form-control-sm media-library-meta-title">
                                        </div>
                                        <div class="metadata-row metadata-edit-row">
                                            <label for="media-library-meta-description">{{ 'Description' | trans }}</label>
                                            <textarea id="media-library-meta-description" class="form-control form-control-sm media-library-meta-description" rows="2"></textarea>
                                        </div>
                                        <div class="metadata-row metadata-edit-row">
                                            <label for="media-library-meta-license">{{ 'License' | trans }}</label>
                                            <select id="media-library-meta-license" class="form-select form-select-sm media-library-meta-license"></select>
                                        </div>
                                        <div class="metadata-author-grid">
                                            <div class="metadata-row metadata-edit-row">
                                                <label for="media-library-meta-author">{{ 'Author' | trans }}</label>
                                                <input type="text" id="media-library-meta-author" class="form-control form-control-sm media-library-meta-author">
                                            </div>
                                            <div class="metadata-row metadata-edit-row">
                                                <label for="media-library-meta-author-url">{{ 'Author link' | trans }}</label>
                                                <input type="url" id="media-library-meta-author-url" class="form-control form-control-sm media-library-meta-author-url">
                                            </div>
                                        </div>
                                        <div class="metadata-row metadata-edit-row">
                                            <label for="media-library-meta-source-url">{{ 'Source URL' | trans }}</label>
                                            <input type="url" id="media-library-meta-source-url" class="form-control form-control-sm media-library-meta-source-url">
                                        </div>
                                        <div class="media-library-caption-preview is-empty">
                                            <p class="media-library-caption-preview-label">{{ 'Resulting caption' | trans }}</p>
                                            <div class="media-library-caption-preview-text"></div>
                                        </div>
                                    </form>
                                </div>

                                <!-- Read-only technical details -->
                                <div class="tab-pane media-library-tab-pane media-library-section-details" data-media-pane="details" role="tabpanel">
                                    <div class="metadata-row metadata-filename">
                                        <label>{{ 'Name' | trans }}:</label>
                                        <span class="media-library-filename"></span>
                                    </div>
                                    <div class="metadata-row">
                                        <label>{{ 'Type' | trans }}:</label>
                                        <span class="media-library-type"></span>
                                    </div>
                                    <div class="metadata-row">
                                        <label>{{ 'Size:' | trans }}</label>
                                        <span class="media-library-size"></span>
                                    </div>
                                    <div class="metadata-row media-library-dimensions-row">
                                        <label>{{ 'Dimensions:' | trans }}</label>
                                        <span class="media-library-dimensions"></span>
                                    </div>
                                    <div class="metadata-row">
                                        <label>{{ 'Added:' | trans }}</label>
                                        <span class="media-library-date"></span>
                                    </div>
                                    <div class="metadata-row media-library-location-row" style="display: none;">
                                        <label>{{ 'Location:' | trans }}</label>
                                        <div class="d-flex align-items-center gap-1 flex-grow-1 min-w-0">
                                            <span class="media-library-location-value text-truncate flex-grow-1">/</span>
                                            <button type="button" class="btn btn-sm btn-link media-library-open-folder-btn p-0" title="{{ 'Open containing folder' | trans }}">
                                                <span class="exe-icon">folder_open</span>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="metadata-row metadata-url-row">
                                        <label>{{ 'Internal URL' | trans }}:</label>
                                        <div class="media-library-url-group">
                                            <input type="text" class="media-library-url" readonly aria-label="{{ 'Internal URL' | trans }}">
                                            <button type="button" class="media-library-copy-url-btn" title="{{ 'Copy URL' | trans }}">
                                                <span class="exe-icon">content_copy</span>
                                            </button>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-secondary media-library-replace-inline-btn">
                                        <span class="exe-icon">find_replace</span> {{ 'Replace file' | trans }}…
                                    </button>
                                    <p class="media-library-replace-hint">{{ 'References and metadata are preserved.' | trans }}</p>
                                </div>

                                <!-- Usage / references -->
                                <div class="tab-pane media-library-tab-pane media-library-section-usage" data-media-pane="usage" role="tabpanel">
                                    <p class="media-library-usage-intro" style="display:none;">{{ 'This file is used in:' | trans }}</p>
                                    <div class="metadata-row media-library-usage-locations-row">
                                        <ul class="media-library-usage-locations" aria-live="polite"></ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer media-library-footer">
                <div class="media-library-footer-actions">
                    <button type="button" class="btn btn-danger media-library-delete-btn d-none d-md-inline-block" disabled>
                        <span class="exe-icon">delete</span> {{ 'Delete' | trans }}
                    </button>
                    <button type="button" class="btn btn-secondary media-library-rename-btn d-none d-md-inline-block" disabled>
                        <span class="exe-icon">edit</span> {{ 'Rename' | trans }}
                    </button>
                    <button type="button" class="btn btn-secondary media-library-duplicate-btn d-none d-md-inline-block" disabled>
                        <span class="exe-icon">content_copy</span> {{ 'Duplicate' | trans }}
                    </button>
                    <button type="button" class="btn btn-secondary media-library-move-btn d-none d-md-inline-block" disabled>
                        <span class="exe-icon">drive_file_move</span> {{ 'Move' | trans }}
                    </button>
                    <button type="button" class="btn btn-secondary media-library-download-btn d-none d-md-inline-block" disabled>
                        <span class="exe-icon">download</span> {{ 'Download' | trans }}
                    </button>

                    <!-- Dropdown More Options (desktop only) -->
                    <div class="dropdown d-none d-md-inline-block">
                        <button type="button" class="btn btn-secondary media-library-more-btn dropdown-toggle" data-bs-toggle="dropdown" disabled>
                            <span class="exe-icon">more_horiz</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item media-library-replace-btn" href="#">
                                <span class="exe-icon">find_replace</span> {{ 'Replace file' | trans }}
                            </a></li>
                            <li><a class="dropdown-item media-library-extract-btn d-none" href="#">
                                <span class="exe-icon">folder_zip</span> {{ 'Extract ZIP' | trans }}
                            </a></li>
                            <li><a class="dropdown-item media-library-copyurl-btn" href="#">
                                <span class="exe-icon">link</span> {{ 'Copy URL' | trans }}
                            </a></li>
                            <li><a class="dropdown-item media-library-fullsize-btn" href="#">
                                <span class="exe-icon">open_in_new</span> {{ 'View full size' | trans }}
                            </a></li>
                        </ul>
                    </div>

                    <!-- Mobile-only: all actions collapsed in one dropdown -->
                    <div class="dropdown d-md-none media-library-mobile-actions">
                        <button type="button" class="btn btn-secondary dropdown-toggle media-library-mobile-actions-toggle" data-bs-toggle="dropdown" disabled>
                            <span class="exe-icon">more_vert</span> {{ 'Actions' | trans }}
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item media-library-edit-metadata-action" href="#" data-mobile-action="edit-metadata">
                                <span class="exe-icon">tune</span> {{ 'Edit metadata' | trans }}
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#" data-mobile-action="delete">
                                <span class="exe-icon">delete</span> {{ 'Delete' | trans }}
                            </a></li>
                            <li><a class="dropdown-item" href="#" data-mobile-action="rename">
                                <span class="exe-icon">edit</span> {{ 'Rename' | trans }}
                            </a></li>
                            <li><a class="dropdown-item" href="#" data-mobile-action="duplicate">
                                <span class="exe-icon">content_copy</span> {{ 'Duplicate' | trans }}
                            </a></li>
                            <li><a class="dropdown-item" href="#" data-mobile-action="move">
                                <span class="exe-icon">drive_file_move</span> {{ 'Move' | trans }}
                            </a></li>
                            <li><a class="dropdown-item" href="#" data-mobile-action="download">
                                <span class="exe-icon">download</span> {{ 'Download' | trans }}
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item d-none" href="#" data-mobile-action="extract-zip">
                                <span class="exe-icon">folder_zip</span> {{ 'Extract ZIP' | trans }}
                            </a></li>
                            <li><a class="dropdown-item" href="#" data-mobile-action="copyurl">
                                <span class="exe-icon">link</span> {{ 'Copy URL' | trans }}
                            </a></li>
                            <li><a class="dropdown-item" href="#" data-mobile-action="fullsize">
                                <span class="exe-icon">open_in_new</span> {{ 'View full size' | trans }}
                            </a></li>
                        </ul>
                    </div>
                </div>

                <button type="button" class="btn btn-primary media-library-insert-btn ms-auto" disabled>
                    <span class="exe-icon">arrow_forward</span> {{ 'Insert' | trans }}
                </button>
            </div>
            <!-- Folder Picker Dialog (inside modal-content for proper positioning) -->
            <div class="media-library-folder-picker" style="display:none;">
                <div class="folder-picker-overlay"></div>
                <div class="folder-picker-dialog">
                    <div class="folder-picker-header">
                        <span class="folder-picker-title">{{ 'Move to folder' | trans }}</span>
                        <button type="button" class="folder-picker-close">&times;</button>
                    </div>
                    <div class="folder-picker-body">
                        <div class="folder-picker-list"></div>
                    </div>
                    <div class="folder-picker-footer">
                        <button type="button" class="btn btn-secondary folder-picker-cancel">{{ 'Cancel' | trans }}</button>
                        <button type="button" class="btn btn-primary folder-picker-confirm">{{ 'Move here' | trans }}</button>
                    </div>
                </div>
            </div>
            <!-- Rename Dialog (inside modal-content for proper positioning) -->
            <div class="media-library-rename-dialog" style="display:none;">
                <div class="rename-dialog-overlay"></div>
                <div class="rename-dialog-content">
                    <div class="rename-dialog-header">
                        <span class="rename-dialog-title"></span>
                        <button type="button" class="rename-dialog-close">&times;</button>
                    </div>
                    <div class="rename-dialog-body">
                        <label class="rename-dialog-label form-label" for="renameDialogInput"></label>
                        <input type="text" class="form-control rename-dialog-input" id="renameDialogInput" autocomplete="off">
                    </div>
                    <div class="rename-dialog-footer">
                        <button type="button" class="btn btn-secondary rename-dialog-cancel">{{ 'Cancel' | trans }}</button>
                        <button type="button" class="btn btn-primary rename-dialog-confirm">{{ 'Rename' | trans }}</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
