                            <label>{{ t.email or 'Email' }}</label>
                            <input type="email" class="admin-input" name="email" required autocomplete="email">
                        </div>
                        <div class="form-group">
                            <label>{{ t.password or 'Password' }}</label>
                            <input type="password" class="admin-input" name="password" required minlength="4" autocomplete="new-password">
