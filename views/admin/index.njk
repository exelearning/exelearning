                                <input type="checkbox" name="roles" value="ROLE_ADMIN" id="editRoleAdmin">
                                <span>ROLE_ADMIN</span>
                            </div>
                            <div class="form-check-custom">
                                <input type="checkbox" name="roles" value="ROLE_EDITOR" id="editRoleEditor">
                                <span>ROLE_EDITOR</span>
                            </div>
