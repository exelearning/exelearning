                        </div>
                        <div class="form-group">
                            <label>{{ t.roles or 'Roles' }}</label>
                            <div class="form-check-custom">
                                <input type="checkbox" name="roles" value="ROLE_USER" checked disabled>
                                <span>ROLE_USER</span>
                                <span class="badge-role badge-user ms-auto">{{ t.protected or 'Protected' }}</span>
                            </div>
