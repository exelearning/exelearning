                            <label>{{ t.quota_mb or 'Quota (MB)' }}</label>
                            <input type="number" class="admin-input" name="quota_mb" min="0" step="1" value="{{ defaultQuota }}" placeholder="{{ t.unlimited or 'Unlimited' }}">
                            <small style="display: block; margin-top: 0.25rem; color: var(--admin-text-muted); font-size: 0.75rem;">{{ t.quota_help or 'Leave empty for unlimited quota' }}</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-admin-outline" data-bs-dismiss="modal">{{ t.cancel or 'Cancel' }}</button>
                        <button type="submit" class="btn-admin-primary">
                            <span class="mi mi-sm">check</span>
                            {{ t.create or 'Create' }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit User Modal -->
    <div class="modal fade" id="editUserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span class="mi">edit</span>
                        {{ t.edit_user or 'Edit User' }}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="editUserForm">
                    <input type="hidden" name="userId">
                    <div class="modal-body">
                        <div class="form-group">
                            <label>{{ t.email or 'Email' }}</label>
                            <input type="email" class="admin-input" name="email" readonly style="background: var(--gray-100);">
                        </div>
                        <div class="form-group">
                            <label>{{ t.roles or 'Roles' }}</label>
                            <div class="form-check-custom">
                                <input type="checkbox" name="roles" value="ROLE_USER" checked disabled>
                                <span>ROLE_USER</span>
                                <span class="badge-role badge-user ms-auto">{{ t.protected or 'Protected' }}</span>
                            </div>
                            <div class="form-check-custom">
                                <input type="checkbox" name="roles" value="ROLE_ADMIN" id="editRoleAdmin">
                                <span>ROLE_ADMIN</span>
                            </div>
                            <div class="form-check-custom">
                                <input type="checkbox" name="roles" value="ROLE_EDITOR" id="editRoleEditor">
                                <span>ROLE_EDITOR</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>{{ t.quota_mb or 'Quota (MB)' }}</label>
                            <input type="number" class="admin-input" name="quota_mb" id="editUserQuota" min="0" step="1" placeholder="{{ t.unlimited or 'Unlimited' }}">
                            <small style="display: block; margin-top: 0.25rem; color: var(--admin-text-muted); font-size: 0.75rem;">{{ t.quota_help or 'Leave empty for unlimited quota' }}</small>
                        </div>
                        <div class="form-group">
                            <label>{{ t.status or 'Status' }}</label>
                            <div class="form-switch-custom">
                                <input type="checkbox" name="is_active" id="editUserActive" class="form-check-input" style="width: 40px; height: 20px;">
                                <span id="editUserStatusLabel">{{ t.active or 'Active' }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-admin-primary btn-admin-danger me-auto" id="deleteUserBtn">
                            <span class="mi mi-sm">delete</span>
                            {{ t.delete or 'Delete' }}
                        </button>
                        <button type="button" class="btn-admin-outline" data-bs-dismiss="modal">{{ t.cancel or 'Cancel' }}</button>
                        <button type="submit" class="btn-admin-primary">
                            <span class="mi mi-sm">save</span>
                            {{ t.save or 'Save' }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="{{ basePath }}/libs/bootstrap/bootstrap.bundle.min.js"></script>
    <script>
        // Configuration
        const API_BASE = '{{ basePath }}/api/admin';
        const T = {
            confirm_delete: '{{ t.confirm_delete or "Are you sure you want to delete this user?" }}',
            confirm_delete_bulk: '{{ t.confirm_delete_bulk or "Are you sure you want to delete {count} users?" }}',
            confirm_delete_project: '{{ t.confirm_delete_project or "Are you sure you want to delete this project?" }}',
            confirm_delete_project_bulk: '{{ t.confirm_delete_project_bulk or "Are you sure you want to delete {count} projects?" }}',
            loading: '{{ t.loading or "Loading" }}',
            dashboard: '{{ t.dashboard or "Dashboard" }}',
            users: '{{ t.users or "Users" }}',
            projects: '{{ t.projects or "Projects" }}',
            extensions: '{{ t.extensions or "Extensions" }}',
            settings: '{{ t.settings or "Settings" }}',
            active: '{{ t.active or "Active" }}',
            inactive: '{{ t.inactive or "Inactive" }}',
            error_loading: '{{ t.error_loading or "Error loading data" }}',
            selected: '{{ t.selected or "selected" }}',
            deleting: '{{ t.deleting or "Deleting..." }}',
            activate: '{{ t.activate or "Activate" }}',
            deactivate: '{{ t.deactivate or "Deactivate" }}'
        };

        // State
        let currentSection = 'dashboard';
        let usersOffset = 0;
        let usersTotal = 0;
        const usersLimit = 20;
        let selectedUserIds = new Set();
        let sortBy = 'id';
        let sortOrder = 'asc';
        let projectsOffset = 0;
        let projectsTotal = 0;
        const projectsLimit = 20;
        let selectedProjectIds = new Set();
        let projectSortBy = 'id';
        let projectSortOrder = 'desc';

        // Navigation
        document.querySelectorAll('.admin-nav-link[data-section]').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                navigateTo(link.dataset.section);
            });
        });

        function navigateTo(section) {
            currentSection = section;

            // Update nav
            document.querySelectorAll('.admin-nav-link[data-section]').forEach(l => l.classList.remove('active'));
            document.querySelector(`[data-section="${section}"]`)?.classList.add('active');

            // Update sections
            document.querySelectorAll('.admin-section').forEach(s => s.classList.remove('active'));
            document.getElementById(section)?.classList.add('active');

            // Update title
            const titles = {
                dashboard: T.dashboard,
                users: T.users,
                projects: T.projects,
                extensions: T.extensions,
                settings: T.settings
            };
            document.getElementById('sectionTitle').textContent = titles[section] || section;

            // Load section data
            if (section === 'dashboard') loadStats();
            if (section === 'users') loadUsers();
            if (section === 'projects') loadProjects();

            // Close mobile sidebar
            document.getElementById('adminSidebar').classList.remove('show');
            document.getElementById('sidebarOverlay').classList.remove('show');
        }

        // Settings save
        const settingsSaveBtn = document.getElementById('settingsSaveBtn');
        const settingsSaveStatus = document.getElementById('settingsSaveStatus');

        if (settingsSaveBtn) {
            settingsSaveBtn.addEventListener('click', async () => {
                settingsSaveBtn.setAttribute('disabled', 'disabled');
                if (settingsSaveStatus) {
                    settingsSaveStatus.textContent = 'Guardando...';
                    settingsSaveStatus.classList.remove('success', 'error');
                }

                try {
                    const settings = collectAdminSettings();
                    const res = await fetch(`${API_BASE}/settings`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ settings }),
                    });

                    if (!res.ok) {
                        const errorData = await res.json().catch(() => ({}));
                        const detail = errorData.message || errorData.error || 'Failed to save settings';
                        throw new Error(detail);
                    }

                    if (settingsSaveStatus) {
                        settingsSaveStatus.textContent = 'Guardado';
                        settingsSaveStatus.classList.add('success');
                    }
                    updateCreateUserDefaultQuota(settings);
                } catch (err) {
                    console.error('Failed to save settings:', err);
                    if (settingsSaveStatus) {
                        settingsSaveStatus.textContent = err?.message || 'Error al guardar';
                        settingsSaveStatus.classList.add('error');
                    }
                } finally {
                    settingsSaveBtn.removeAttribute('disabled');
                }
            });
        }

        function collectAdminSettings() {
            const inputs = Array.from(document.querySelectorAll('[data-setting-key]'));
            const grouped = new Map();

            inputs.forEach(input => {
                const key = input.dataset.settingKey;
                const type = input.dataset.settingType || 'string';
                if (!key) return;

                if (type === 'csv') {
                    if (!grouped.has(key)) {
                        grouped.set(key, { key, type: 'string', options: [] });
                    }
                    if (input.checked) {
                        grouped.get(key).options.push(input.dataset.settingOption);
                    }
                    return;
                }

                let value = '';
                if (type === 'boolean') {
                    value = input.checked ? 'true' : 'false';
                } else {
                    value = input.value ?? '';
                }
                grouped.set(key, { key, value: String(value), type });
            });

            return Array.from(grouped.values()).map(entry => {
                if (entry.options) {
                    return { key: entry.key, value: entry.options.join(','), type: 'string' };
                }
                return entry;
            });
        }

        function updateCreateUserDefaultQuota(settings) {
            const defaultQuotaSetting = settings.find(setting => setting.key === 'DEFAULT_QUOTA');
            if (!defaultQuotaSetting) return;
            const quotaInput = document.querySelector('#createUserForm [name="quota_mb"]');
            if (!quotaInput) return;
            quotaInput.value = defaultQuotaSetting.value ?? '';
        }

        // Load stats
        async function loadStats() {
            try {
                const res = await fetch(`${API_BASE}/stats`, { credentials: 'include' });
                if (!res.ok) throw new Error('Failed to load stats');
                const data = await res.json();

                document.getElementById('stat-totalUsers').textContent = data.totalUsers ?? '-';
                document.getElementById('stat-activeUsers').textContent = data.activeUsers ?? '-';
                document.getElementById('stat-totalProjects').textContent = data.totalProjects ?? '-';
                document.getElementById('stat-activeProjects').textContent = data.activeProjects ?? '-';
            } catch (err) {
                console.error('Failed to load stats:', err);
            }
        }

        // Load users
        async function loadUsers() {
            const tbody = document.getElementById('usersTableBody');
            const loading = document.getElementById('usersLoading');

            loading.classList.add('active');

            try {
                const search = document.getElementById('userSearch').value;
                const url = new URL(`${API_BASE}/users`, window.location.origin);
                url.searchParams.set('limit', usersLimit);
                url.searchParams.set('offset', usersOffset);
                url.searchParams.set('sortBy', sortBy);
                url.searchParams.set('sortOrder', sortOrder);
                if (search) url.searchParams.set('search', search);

                const res = await fetch(url, { credentials: 'include' });
                if (!res.ok) throw new Error('Failed to load users');
                const data = await res.json();

                usersTotal = data.total;
                tbody.innerHTML = '';

                data.users.forEach(user => {
                    const roles = user.roles.map(r => {
                        const cls = r === 'ROLE_ADMIN' ? 'badge-admin' : r === 'ROLE_EDITOR' ? 'badge-editor' : 'badge-user';
                        return `<span class="badge-role ${cls}">${r.replace('ROLE_', '')}</span>`;
                    }).join(' ');

                    const statusCls = user.is_active ? 'badge-active' : 'badge-inactive';
                    const statusText = user.is_active ? T.active : T.inactive;
                    const isChecked = selectedUserIds.has(user.id) ? 'checked' : '';

                    // Build quota display with progress bar
                    let quotaHTML = '';
                    if (user.quota_mb == null) {
                        quotaHTML = '<span class="quota-unlimited">Unlimited</span>';
                    } else {
                        const usedMB = user.storage_used_mb || 0;
                        const quotaMB = user.quota_mb;
                        const percentage = quotaMB > 0 ? Math.min(Math.round((usedMB / quotaMB) * 100), 100) : 0;

                        // Determine color class based on usage
                        let fillClass = '';
                        if (percentage >= 90) {
                            fillClass = 'danger';
                        } else if (percentage >= 75) {
                            fillClass = 'warning';
                        }

                        quotaHTML = `
                            <div class="quota-container">
                                <div class="quota-text">
                                    <span style="font-weight: 500;">${usedMB} / ${quotaMB} MB</span>
                                    <span>${percentage}%</span>
                                </div>
                                <div class="quota-bar">
                                    <div class="quota-fill ${fillClass}" style="width: ${percentage}%"></div>
                                </div>
                            </div>
                        `;
                    }

                    const tr = document.createElement('tr');
                    tr.dataset.userId = user.id;
                    tr.innerHTML = `
                        <td>
                            <input type="checkbox" class="bulk-checkbox user-checkbox" data-user-id="${user.id}" ${isChecked}>
                        </td>
                        <td style="font-weight: 600; color: var(--admin-text-muted);">#${user.id}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar user-avatar-sm">${(user.email[0] || 'U').toUpperCase()}</div>
                                <span style="font-weight: 500;">${user.email}</span>
                            </div>
                        </td>
                        <td>${roles}</td>
                        <td>${quotaHTML}</td>
                        <td><span class="badge-role ${statusCls}">${statusText}</span></td>
                        <td>
                            <button class="btn-admin-outline" onclick="editUser(${user.id})" title="Edit">
                                <span class="mi mi-sm">edit</span>
                            </button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });

                // Bind checkbox events
                bindUserCheckboxes();

                // Update sort icons
                updateSortIcons();

                updatePagination();
            } catch (err) {
                console.error('Failed to load users:', err);
                tbody.innerHTML = `<tr><td colspan="6" class="text-center" style="padding: 2rem; color: var(--system-red);">${T.error_loading}</td></tr>`;
            } finally {
                loading.classList.remove('active');
            }
        }

        function updatePagination() {
            const paginationEl = document.getElementById('usersPagination');
            const prevBtn = document.getElementById('usersPrevBtn');
            const nextBtn = document.getElementById('usersNextBtn');

            const start = usersTotal > 0 ? usersOffset + 1 : 0;
            const end = Math.min(usersOffset + usersLimit, usersTotal);
            paginationEl.textContent = `${start}-${end} of ${usersTotal}`;

            prevBtn.disabled = usersOffset === 0;
            nextBtn.disabled = usersOffset + usersLimit >= usersTotal;
        }

        document.getElementById('usersPrevBtn').addEventListener('click', () => {
            usersOffset = Math.max(0, usersOffset - usersLimit);
            loadUsers();
        });

        document.getElementById('usersNextBtn').addEventListener('click', () => {
            usersOffset += usersLimit;
            loadUsers();
        });

        // Sort functionality
        function updateSortIcons() {
            document.querySelectorAll('.admin-table th.sortable[data-sort]').forEach(th => {
                const col = th.dataset.sort;
                const icon = th.querySelector('.sort-icon');

                if (col === sortBy) {
                    th.classList.add('sorted');
                    icon.textContent = sortOrder === 'asc' ? 'expand_less' : 'expand_more';
                } else {
                    th.classList.remove('sorted');
                    icon.textContent = 'unfold_more';
                }
            });
        }

        document.querySelectorAll('.admin-table th.sortable[data-sort]').forEach(th => {
            th.addEventListener('click', () => {
                const col = th.dataset.sort;
                if (sortBy === col) {
                    sortOrder = sortOrder === 'asc' ? 'desc' : 'asc';
                } else {
                    sortBy = col;
                    sortOrder = 'asc';
                }
                usersOffset = 0;
                loadUsers();
            });
        });

        // Bulk selection functions
        function bindUserCheckboxes() {
            document.querySelectorAll('.user-checkbox').forEach(cb => {
                cb.addEventListener('change', (e) => {
                    const userId = parseInt(e.target.dataset.userId);
                    if (e.target.checked) {
                        selectedUserIds.add(userId);
                    } else {
                        selectedUserIds.delete(userId);
                    }
                    updateBulkActionsBar();
                    updateSelectAllCheckbox();
                });
            });
        }

        function updateBulkActionsBar() {
            const bar = document.getElementById('bulkActionsBar');
            const countEl = document.getElementById('selectedCount');
            const count = selectedUserIds.size;

            if (count > 0) {
                bar.classList.add('active');
                countEl.textContent = `${count} ${T.selected}`;
            } else {
                bar.classList.remove('active');
            }
        }

        function updateSelectAllCheckbox() {
            const selectAll = document.getElementById('selectAllUsers');
            const checkboxes = document.querySelectorAll('.user-checkbox');
            const checkedCount = document.querySelectorAll('.user-checkbox:checked').length;

            if (checkboxes.length === 0) {
                selectAll.checked = false;
                selectAll.indeterminate = false;
            } else if (checkedCount === 0) {
                selectAll.checked = false;
                selectAll.indeterminate = false;
            } else if (checkedCount === checkboxes.length) {
                selectAll.checked = true;
                selectAll.indeterminate = false;
            } else {
                selectAll.checked = false;
                selectAll.indeterminate = true;
            }
        }

        // Select all checkbox
        document.getElementById('selectAllUsers').addEventListener('change', (e) => {
            const checkboxes = document.querySelectorAll('.user-checkbox');
            checkboxes.forEach(cb => {
                cb.checked = e.target.checked;
                const userId = parseInt(cb.dataset.userId);
                if (e.target.checked) {
                    selectedUserIds.add(userId);
                } else {
                    selectedUserIds.delete(userId);
                }
            });
            updateBulkActionsBar();
        });

        // Clear selection button
        document.getElementById('clearSelectionBtn').addEventListener('click', () => {
            selectedUserIds.clear();
            document.querySelectorAll('.user-checkbox').forEach(cb => cb.checked = false);
            document.getElementById('selectAllUsers').checked = false;
            document.getElementById('selectAllUsers').indeterminate = false;
            updateBulkActionsBar();
        });

        // Bulk delete button
        document.getElementById('bulkDeleteBtn').addEventListener('click', async () => {
            const count = selectedUserIds.size;
            if (count === 0) return;

            const confirmMsg = T.confirm_delete_bulk.replace('{count}', count);
            if (!confirm(confirmMsg)) return;

            const btn = document.getElementById('bulkDeleteBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = `<span class="mi mi-sm">hourglass_empty</span> ${T.deleting}`;
            btn.disabled = true;

            let deleted = 0;
            let errors = [];

            for (const userId of selectedUserIds) {
                try {
                    const res = await fetch(`${API_BASE}/users/${userId}`, {
                        method: 'DELETE',
                        credentials: 'include'
                    });

                    if (res.ok) {
                        deleted++;
                    } else {
                        const data = await res.json();
                        errors.push(`User ${userId}: ${data.message || 'Failed'}`);
                    }
                } catch (err) {
                    errors.push(`User ${userId}: ${err.message}`);
                }
            }

            btn.innerHTML = originalText;
            btn.disabled = false;

            if (errors.length > 0) {
                alert(`Deleted ${deleted} users. Errors:\n${errors.join('\n')}`);
            }

            // Clear selection and reload
            selectedUserIds.clear();
            document.getElementById('selectAllUsers').checked = false;
            updateBulkActionsBar();
            loadUsers();
        });

        // Search debounce
        let searchTimeout;
        document.getElementById('userSearch').addEventListener('input', () => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                usersOffset = 0;
                loadUsers();
            }, 300);
        });

        // Load projects
        async function loadProjects() {
            const tbody = document.getElementById('projectsTableBody');
            const loading = document.getElementById('projectsLoading');

            loading.classList.add('active');

            try {
                const owner = document.getElementById('projectOwnerFilter').value.trim();
                const title = document.getElementById('projectTitleFilter').value.trim();
                const status = document.getElementById('projectStatusFilter').value;
                const visibility = document.getElementById('projectVisibilityFilter').value;
                const isActive = document.getElementById('projectIsActiveFilter').value;

                const url = new URL(`${API_BASE}/projects`, window.location.origin);
                url.searchParams.set('limit', projectsLimit);
                url.searchParams.set('offset', projectsOffset);
                url.searchParams.set('sortBy', projectSortBy);
                url.searchParams.set('sortOrder', projectSortOrder);
                if (owner) url.searchParams.set('owner', owner);
                if (title) url.searchParams.set('title', title);
                if (status) url.searchParams.set('status', status);
                if (visibility) url.searchParams.set('visibility', visibility);
                if (isActive) url.searchParams.set('is_active', isActive);

                const res = await fetch(url, { credentials: 'include' });
                if (!res.ok) throw new Error('Failed to load projects');
                const data = await res.json();

                projectsTotal = data.total;
                tbody.innerHTML = '';

                data.projects.forEach(project => {
                    const statusClass = project.status === 'active'
                        ? 'badge-active'
                        : project.status === 'archived'
                            ? 'badge-archived'
                            : 'badge-deleted';
                    const visibilityClass = 'badge-user';
                    const activeClass = project.is_active ? 'badge-active' : 'badge-inactive';
                    const activeText = project.is_active ? T.active : T.inactive;
                    const toggleLabel = project.is_active ? T.deactivate : T.activate;
                    const toggleIcon = project.is_active ? 'toggle_off' : 'toggle_on';
                    const ownerLabel = project.owner_email || project.owner_user_id || `#${project.owner_id}`;
                    const createdAt = project.created_at ? new Date(project.created_at).toLocaleDateString() : '-';
                    const isChecked = selectedProjectIds.has(project.id) ? 'checked' : '';

                    const tr = document.createElement('tr');
                    tr.dataset.projectId = project.id;
                    tr.innerHTML = `
                        <td>
                            <input type="checkbox" class="bulk-checkbox project-checkbox" data-project-id="${project.id}" ${isChecked}>
                        </td>
                        <td style="font-weight: 600; color: var(--admin-text-muted);">#${project.id}</td>
                        <td>${project.title || '-'}</td>
                        <td>${ownerLabel}</td>
                        <td><span class="badge-role ${statusClass}">${project.status}</span></td>
                        <td><span class="badge-role ${visibilityClass}">${project.visibility}</span></td>
                        <td><span class="badge-role ${activeClass}">${activeText}</span></td>
                        <td>${createdAt}</td>
                        <td>
                            <button class="btn-admin-outline" onclick="toggleProjectActive(${project.id}, ${project.is_active ? 'false' : 'true'})" title="${toggleLabel}">
                                <span class="mi mi-sm">${toggleIcon}</span>
                            </button>
                            <button class="btn-admin-outline btn-admin-danger" onclick="deleteProject(${project.id})" title="{{ t.delete or 'Delete' }}">
                                <span class="mi mi-sm">delete</span>
                            </button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });

                bindProjectCheckboxes();
                updateProjectSortIcons();
                updateProjectsPagination();
            } catch (err) {
                console.error('Failed to load projects:', err);
                tbody.innerHTML = `<tr><td colspan="9" class="text-center" style="padding: 2rem; color: var(--system-red);">${T.error_loading}</td></tr>`;
            } finally {
                loading.classList.remove('active');
            }
        }

        function updateProjectsPagination() {
            const paginationEl = document.getElementById('projectsPagination');
            const prevBtn = document.getElementById('projectsPrevBtn');
            const nextBtn = document.getElementById('projectsNextBtn');

            const start = projectsTotal > 0 ? projectsOffset + 1 : 0;
            const end = Math.min(projectsOffset + projectsLimit, projectsTotal);
            paginationEl.textContent = `${start}-${end} of ${projectsTotal}`;

            prevBtn.disabled = projectsOffset === 0;
            nextBtn.disabled = projectsOffset + projectsLimit >= projectsTotal;
        }

        document.getElementById('projectsPrevBtn').addEventListener('click', () => {
            projectsOffset = Math.max(0, projectsOffset - projectsLimit);
            loadProjects();
        });

        document.getElementById('projectsNextBtn').addEventListener('click', () => {
            projectsOffset += projectsLimit;
            loadProjects();
        });

        function updateProjectSortIcons() {
            document.querySelectorAll('.admin-table th.sortable[data-sort-project]').forEach(th => {
                const col = th.dataset.sortProject;
                const icon = th.querySelector('.sort-icon');

                if (col === projectSortBy) {
                    th.classList.add('sorted');
                    icon.textContent = projectSortOrder === 'asc' ? 'expand_less' : 'expand_more';
                } else {
                    th.classList.remove('sorted');
                    icon.textContent = 'unfold_more';
                }
            });
        }

        document.querySelectorAll('.admin-table th.sortable[data-sort-project]').forEach(th => {
            th.addEventListener('click', () => {
                const col = th.dataset.sortProject;
                if (projectSortBy === col) {
                    projectSortOrder = projectSortOrder === 'asc' ? 'desc' : 'asc';
                } else {
                    projectSortBy = col;
                    projectSortOrder = 'asc';
                }
                projectsOffset = 0;
                loadProjects();
            });
        });

        function bindProjectCheckboxes() {
            document.querySelectorAll('.project-checkbox').forEach(cb => {
                cb.addEventListener('change', (e) => {
                    const projectId = parseInt(e.target.dataset.projectId);
                    if (e.target.checked) {
                        selectedProjectIds.add(projectId);
                    } else {
                        selectedProjectIds.delete(projectId);
                    }
                    updateProjectsBulkActionsBar();
                    updateProjectsSelectAllCheckbox();
                });
            });
        }

        function updateProjectsBulkActionsBar() {
            const bar = document.getElementById('projectsBulkActionsBar');
            const countEl = document.getElementById('projectsSelectedCount');
            const count = selectedProjectIds.size;

            if (count > 0) {
                bar.classList.add('active');
                countEl.textContent = `${count} ${T.selected}`;
            } else {
                bar.classList.remove('active');
            }
        }

        function updateProjectsSelectAllCheckbox() {
            const selectAll = document.getElementById('selectAllProjects');
            const checkboxes = document.querySelectorAll('.project-checkbox');
            const checkedCount = document.querySelectorAll('.project-checkbox:checked').length;

            if (checkboxes.length === 0) {
                selectAll.checked = false;
                selectAll.indeterminate = false;
            } else if (checkedCount === 0) {
                selectAll.checked = false;
                selectAll.indeterminate = false;
            } else if (checkedCount === checkboxes.length) {
                selectAll.checked = true;
                selectAll.indeterminate = false;
            } else {
                selectAll.checked = false;
                selectAll.indeterminate = true;
            }
        }

        document.getElementById('selectAllProjects').addEventListener('change', (e) => {
            const checkboxes = document.querySelectorAll('.project-checkbox');
            checkboxes.forEach(cb => {
                cb.checked = e.target.checked;
                const projectId = parseInt(cb.dataset.projectId);
                if (e.target.checked) {
                    selectedProjectIds.add(projectId);
                } else {
                    selectedProjectIds.delete(projectId);
                }
            });
            updateProjectsBulkActionsBar();
        });

        document.getElementById('projectsClearSelectionBtn').addEventListener('click', () => {
            selectedProjectIds.clear();
            document.querySelectorAll('.project-checkbox').forEach(cb => cb.checked = false);
            document.getElementById('selectAllProjects').checked = false;
            document.getElementById('selectAllProjects').indeterminate = false;
            updateProjectsBulkActionsBar();
        });

        document.getElementById('projectsBulkDeleteBtn').addEventListener('click', async () => {
            const count = selectedProjectIds.size;
            if (count === 0) return;

            const confirmMsg = T.confirm_delete_project_bulk.replace('{count}', count);
            if (!confirm(confirmMsg)) return;

            const btn = document.getElementById('projectsBulkDeleteBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = `<span class="mi mi-sm">hourglass_empty</span> ${T.deleting}`;
            btn.disabled = true;

            let deleted = 0;
            let errors = [];

            for (const projectId of selectedProjectIds) {
                try {
                    const res = await fetch(`${API_BASE}/projects/${projectId}`, {
                        method: 'DELETE',
                        credentials: 'include'
                    });

                    if (res.ok) {
                        deleted++;
                    } else {
                        const data = await res.json();
                        errors.push(`Project ${projectId}: ${data.message || 'Failed'}`);
                    }
                } catch (err) {
                    errors.push(`Project ${projectId}: ${err.message}`);
                }
            }

            btn.innerHTML = originalText;
            btn.disabled = false;

            if (errors.length > 0) {
                alert(`Deleted ${deleted} projects. Errors:\n${errors.join('\n')}`);
            }

            selectedProjectIds.clear();
            document.getElementById('selectAllProjects').checked = false;
            updateProjectsBulkActionsBar();
            loadProjects();
        });

        let projectFilterTimeout;
        ['projectOwnerFilter', 'projectTitleFilter'].forEach(id => {
            document.getElementById(id).addEventListener('input', () => {
                clearTimeout(projectFilterTimeout);
                projectFilterTimeout = setTimeout(() => {
                    projectsOffset = 0;
                    loadProjects();
                }, 300);
            });
        });

        ['projectStatusFilter', 'projectVisibilityFilter', 'projectIsActiveFilter'].forEach(id => {
            document.getElementById(id).addEventListener('change', () => {
                projectsOffset = 0;
                loadProjects();
            });
        });

        async function toggleProjectActive(projectId, isActive) {
            try {
                const res = await fetch(`${API_BASE}/projects/${projectId}/active`, {
                    method: 'PATCH',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ is_active: isActive })
                });

                if (!res.ok) {
                    const data = await res.json();
                    throw new Error(data.message || 'Failed to update project');
                }

                loadProjects();
            } catch (err) {
                console.error('Failed to update project:', err);
                alert(err.message || 'Failed to update project');
            }
        }

        async function deleteProject(projectId) {
            if (!confirm(T.confirm_delete_project)) return;

            try {
                const res = await fetch(`${API_BASE}/projects/${projectId}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });

                if (!res.ok) {
                    const data = await res.json();
                    throw new Error(data.message || 'Failed to delete project');
                }

                loadProjects();
            } catch (err) {
                console.error('Failed to delete project:', err);
                alert(err.message || 'Failed to delete project');
            }
        }

        // Edit user
        async function editUser(userId) {
            try {
                const res = await fetch(`${API_BASE}/users/${userId}`, { credentials: 'include' });
                if (!res.ok) throw new Error('Failed to load user');
                const data = await res.json();
                const user = data.user;

                const form = document.getElementById('editUserForm');
                form.querySelector('[name="userId"]').value = user.id;
                form.querySelector('[name="email"]').value = user.email;
                document.getElementById('editRoleAdmin').checked = user.roles.includes('ROLE_ADMIN');
                document.getElementById('editRoleEditor').checked = user.roles.includes('ROLE_EDITOR');
                document.getElementById('editUserQuota').value = user.quota_mb != null ? user.quota_mb : '';
                document.getElementById('editUserActive').checked = user.is_active === 1;
                document.getElementById('editUserStatusLabel').textContent = user.is_active === 1 ? T.active : T.inactive;

                new bootstrap.Modal(document.getElementById('editUserModal')).show();
            } catch (err) {
                console.error('Failed to load user:', err);
                alert('Failed to load user');
            }
        }

        // Update status label
        document.getElementById('editUserActive').addEventListener('change', (e) => {
            document.getElementById('editUserStatusLabel').textContent = e.target.checked ? T.active : T.inactive;
        });

        // Save user
        document.getElementById('editUserForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const userId = form.querySelector('[name="userId"]').value;

            const roles = ['ROLE_USER'];
            if (document.getElementById('editRoleAdmin').checked) roles.push('ROLE_ADMIN');
            if (document.getElementById('editRoleEditor').checked) roles.push('ROLE_EDITOR');

            const isActive = document.getElementById('editUserActive').checked;
            const quotaValue = document.getElementById('editUserQuota').value;
            const quota_mb = quotaValue === '' ? null : parseInt(quotaValue, 10);

            try {
                // Update roles
                let res = await fetch(`${API_BASE}/users/${userId}/roles`, {
                    method: 'PATCH',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ roles })
                });

                if (!res.ok) {
                    const data = await res.json();
                    throw new Error(data.message || 'Failed to update roles');
                }

                // Update status
                res = await fetch(`${API_BASE}/users/${userId}/status`, {
                    method: 'PATCH',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ is_active: isActive })
                });

                if (!res.ok) {
                    const data = await res.json();
                    throw new Error(data.message || 'Failed to update status');
                }

                // Update quota
                res = await fetch(`${API_BASE}/users/${userId}/quota`, {
                    method: 'PATCH',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ quota_mb })
                });

                if (!res.ok) {
                    const data = await res.json();
                    throw new Error(data.message || 'Failed to update quota');
                }

                bootstrap.Modal.getInstance(document.getElementById('editUserModal')).hide();
                loadUsers();
            } catch (err) {
                console.error('Failed to save user:', err);
                alert(err.message || 'Failed to save user');
            }
        });

        // Delete user
        document.getElementById('deleteUserBtn').addEventListener('click', async () => {
            if (!confirm(T.confirm_delete)) return;

            const userId = document.getElementById('editUserForm').querySelector('[name="userId"]').value;

            try {
                const res = await fetch(`${API_BASE}/users/${userId}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });

                if (!res.ok) {
                    const data = await res.json();
                    throw new Error(data.message || 'Failed to delete user');
                }

                bootstrap.Modal.getInstance(document.getElementById('editUserModal')).hide();
                loadUsers();
            } catch (err) {
                console.error('Failed to delete user:', err);
                alert(err.message || 'Failed to delete user');
            }
        });

        // Create user
        document.getElementById('createUserForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;

            const roles = ['ROLE_USER'];
            form.querySelectorAll('[name="roles"]:checked:not(:disabled)').forEach(cb => {
                roles.push(cb.value);
            });

            const quotaValue = form.querySelector('[name="quota_mb"]').value;
            const quota_mb = quotaValue === '' ? null : parseInt(quotaValue, 10);

            try {
                const res = await fetch(`${API_BASE}/users`, {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        email: form.querySelector('[name="email"]').value,
                        password: form.querySelector('[name="password"]').value,
                        roles,
                        quota_mb
                    })
                });

                if (!res.ok) {
                    const data = await res.json();
                    throw new Error(data.message || 'Failed to create user');
                }

                bootstrap.Modal.getInstance(document.getElementById('createUserModal')).hide();
                form.reset();
                navigateTo('users');
            } catch (err) {
                console.error('Failed to create user:', err);
                alert(err.message || 'Failed to create user');
            }
        });

        // Sidebar toggle (mobile)
        document.getElementById('sidebarToggle')?.addEventListener('click', () => {
            document.getElementById('adminSidebar').classList.toggle('show');
            document.getElementById('sidebarOverlay').classList.toggle('show');
        });

        document.getElementById('sidebarOverlay')?.addEventListener('click', () => {
            document.getElementById('adminSidebar').classList.remove('show');
            document.getElementById('sidebarOverlay').classList.remove('show');
        });

        // Extension tabs
        document.querySelectorAll('.admin-tab[data-ext-type]').forEach(tab => {
            tab.addEventListener('click', (e) => {
                e.preventDefault();
                document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
            });
        });

        // Initial load
        loadStats();
    </script>
</body>
</html>
